---
import Button from './Button.astro';

// Owner 2026-11-23: Events and Flow AI are the current work, timed for the December release.
// The mobile companion app is loosely planned. Facts from flowmastersuite docs/roadmap
// (event-detection and editing-assistant master plans). No accuracy figures or pricing until set.
const coming = [
  {
    name: 'Events',
    image: '/images/roadmap/events-preview.jpg',
    alt: 'The Events tab: a scanned recording with its events on a timeline and a list of detected moments with Jump buttons',
    lead: 'Flowmaster scans the pixels on your screen.',
    body: 'After you record, Events reads the HUD and game sounds in your footage and finds the kills, objectives and round wins for you. Every moment lands on a timeline you can jump through and clip from, alongside your own marks.',
  },
  {
    name: 'Flow AI',
    image: '/images/roadmap/flow-preview.jpg',
    alt: 'The Flow AI tab: asked what video to make this week, Flow suggests a streak montage and shows a plan waiting for approval',
    lead: 'Your AI editing buddy.',
    body: 'Ask what to make from this week’s recordings. Flow reads your marks and events, then builds clip pools, montages and editor handoffs. Every action is a preview you approve first.',
  },
];
---

<section id="future-preview" class="section-padding bg-bg-secondary">
  <div class="container-main">
    <p class="future-kicker">Coming in December</p>
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">
      Coming to <span class="text-brand-red">Flowmaster</span>
    </h2>
    <p class="text-text-secondary text-center max-w-2xl mx-auto mb-12">
      Two new tabs, Events and Flow AI, are in development for the December release.
    </p>

    <div class="grid lg:grid-cols-2 gap-8">
      {coming.map(item => (
        <article class="future-card">
          <div class="future-shot">
            <img src={item.image} alt={item.alt} loading="lazy" width="1080" height="800" />
            <span class="future-tag">In development</span>
          </div>
          <div class="future-copy">
            <h3>{item.name}</h3>
            <p class="future-lead">{item.lead}</p>
            <p class="text-text-secondary text-sm">{item.body}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="future-motto">Flow suggests. You decide.</p>

    <div class="text-center">
      <Button href="/future" variant="secondary">
        See the roadmap →
      </Button>
    </div>
  </div>
</section>

<style>
  .future-kicker { text-align: center; margin: 0 0 .75rem; font: 600 .75rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .14em; text-transform: uppercase; color: #ff5959; }
  .future-card { display: flex; flex-direction: column; overflow: hidden; border-radius: 14px; border: 1px solid #262626; background: #101010; transition: border-color .3s ease; }
  .future-card:hover { border-color: rgba(244, 63, 67, .45); }
  .future-shot { position: relative; aspect-ratio: 27 / 20; overflow: hidden; background: #07080b; }
  .future-shot img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .future-tag { position: absolute; top: 12px; right: 12px; padding: .3rem .6rem; border-radius: 999px; background: rgba(10, 10, 10, .78); border: 1px solid rgba(255, 255, 255, .14); color: #d4d4d4; font-size: .7rem; font-weight: 600; letter-spacing: .02em; backdrop-filter: blur(4px); }
  .future-copy { padding: 1.5rem; }
  .future-copy h3 { font-size: 1.35rem; font-weight: 700; margin: 0 0 .35rem; }
  .future-lead { margin: 0 0 .6rem; color: #f2f2f2; font-weight: 500; }
  .future-motto { margin: 2.5rem 0 1.5rem; text-align: center; font-size: 1.25rem; font-weight: 600; color: #f2f2f2; }
</style>
