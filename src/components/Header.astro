---
const navLinks = [
  { href: '/pricing', label: 'Free trial' },
  { href: '/download', label: 'Download' },
  { href: '/docs', label: 'Docs' },
  { href: '/future', label: 'Future' },
  { href: '/account', label: 'Account' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// On the homepage the logo is the identifier, so the nav waits until you scroll.
const autohide = path === '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header id="main-nav" class:list={['site-nav', { 'is-autohide': autohide }]} data-autohide={autohide ? '' : undefined}>
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="Flowmaster home">
      <img class="nav-emblem" src="/brand/LogoEmblem.svg" alt="" width="62" height="17" />
      <img class="nav-type" src="/brand/FlowmasterType.svg" alt="Flowmaster" width="113" height="22" />
    </a>

    <nav class="nav-links" aria-label="Main">
      {navLinks.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>

    <a href="/account" class="btn-primary nav-cta">Create a free account</a>

    <button id="mobile-menu-btn" class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">Menu</span>
      <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>

  <div id="mobile-menu" class="nav-drawer" hidden>
    <nav aria-label="Main, mobile">
      {navLinks.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <a href="/account" class="btn-primary">Create a free account</a>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: rgba(16, 16, 16, 0.86);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rule);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .site-nav.is-autohide:not(.is-shown):not(:focus-within) { opacity: 0; transform: translateY(-100%); pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { .site-nav { transition: none; } }
  .nav-inner {
    width: min(100% - 2 * var(--pad), var(--wrap));
    height: var(--nav-h);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.75rem;
    flex: none;
  }
  .nav-emblem { width: 3.4rem; height: auto; }
  .nav-type { width: 6.6rem; height: auto; }

  .nav-links {
    display: none;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }
  .nav-links a {
    position: relative;
    padding: 0.7rem 0.8rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
  }
  .nav-links a:hover { color: var(--ink); }
  .nav-links a[aria-current='page'] { color: var(--ink); }
  .nav-links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.35rem;
    height: 2px;
    background: var(--red);
  }

  .nav-cta {
    display: none;
    min-height: 2.5rem;
    padding: 0.55rem 1rem;
    font-size: 0.92rem;
  }

  .nav-toggle {
    margin-left: auto;
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .nav-toggle-bars { display: grid; gap: 4px; }
  .nav-toggle-bars i {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars i:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars i:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars i:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .nav-drawer {
    border-top: 1px solid var(--rule);
    background: var(--ground);
    padding: 0.5rem var(--pad) 1.5rem;
  }
  .nav-drawer[hidden] { display: none; }
  .nav-drawer nav { display: grid; }
  .nav-drawer nav a {
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-heading);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }
  .nav-drawer nav a[aria-current='page'] { color: var(--red); }
  .nav-drawer .btn-primary { width: 100%; margin-top: 1.25rem; }

  @media (min-width: 560px) {
    .nav-cta { display: inline-flex; margin-left: auto; }
    .nav-toggle { margin-left: 0; }
    .nav-inner { gap: 0.75rem; }
  }
  @media (min-width: 900px) {
    .nav-links { display: flex; }
    .nav-cta { margin-left: 0.75rem; }
    .nav-toggle { display: none; }
    .nav-drawer { display: none; }
    .nav-inner { gap: 2rem; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-autohide]');
  if (nav) {
    const update = () => nav.classList.toggle('is-shown', window.scrollY > window.innerHeight * 0.35);
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  const button = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-menu');

  if (button && drawer) {
    const setOpen = (open: boolean) => {
      drawer.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
    };
    button.addEventListener('click', () => setOpen(drawer.hidden));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !drawer.hidden) {
        setOpen(false);
        button.focus();
      }
    });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
