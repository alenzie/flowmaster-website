---
import Button from './Button.astro';
---

<section id="features-preview" class="section-padding">
  <div class="container-main">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">
      Packed with <span class="text-brand-red">Features</span>
    </h2>
    <p class="text-text-secondary text-center max-w-2xl mx-auto mb-12">
      Everything you need to edit smarter, not harder
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
      <!-- Feature 1: Global Hotkey -->
      <div class="bg-bg-secondary rounded-xl p-6 border border-gray-800 hover:border-brand-red/50 transition-colors duration-300">
        <div class="feature-icon-wrap mb-4"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10"/></svg></div>
        <h3 class="text-lg font-semibold mb-2">Global Hotkey</h3>
        <p class="text-text-secondary text-sm">
          Mark highlights instantly with a customizable hotkey - no alt-tabbing required.
        </p>
      </div>

      <!-- Feature 2: Smart File Matching -->
      <div class="bg-bg-secondary rounded-xl p-6 border border-gray-800 hover:border-brand-red/50 transition-colors duration-300">
        <div class="feature-icon-wrap mb-4"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9.5 13.5l2 2 3.5-4"/></svg></div>
        <h3 class="text-lg font-semibold mb-2">Smart File Matching</h3>
        <p class="text-text-secondary text-sm">
          Automatically finds and links your recording files based on timestamps.
        </p>
      </div>

      <!-- Feature 3: Auto-Remux -->
      <div class="bg-bg-secondary rounded-xl p-6 border border-gray-800 hover:border-brand-red/50 transition-colors duration-300">
        <div class="feature-icon-wrap mb-4"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h12l-3-3M20 16H8l3 3"/></svg></div>
        <h3 class="text-lg font-semibold mb-2">Auto-Remux</h3>
        <p class="text-text-secondary text-sm">
          Converts MKV recordings to editor-friendly MP4 while cutting - no manual remuxing required.
        </p>
      </div>

      <!-- Feature 4: Recycle Bin Safe -->
      <div class="bg-bg-secondary rounded-xl p-6 border border-gray-800 hover:border-brand-red/50 transition-colors duration-300">
        <div class="feature-icon-wrap mb-4"><svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M6 7l1 12a1.5 1.5 0 0 0 1.5 1.4h7A1.5 1.5 0 0 0 17 19l1-12M10 11v6M14 11v6"/></svg></div>
        <h3 class="text-lg font-semibold mb-2">Recycle Bin Safe</h3>
        <p class="text-text-secondary text-sm">
          Deleted footage goes to recycle bin first - recover accidentally removed clips easily.
        </p>
      </div>
    </div>

    <div class="text-center">
      <Button href="/features" variant="secondary">
        See all features →
      </Button>
    </div>
  </div>
</section>

<style>
  .feature-icon-wrap { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 10px; background: rgba(244, 63, 67, .1); border: 1px solid rgba(244, 63, 67, .28); color: #ff5959; }
  .feature-icon { width: 24px; height: 24px; }
</style>
