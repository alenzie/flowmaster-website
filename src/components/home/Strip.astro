---
// The sample session, drawn at one of three stages. A diagram, not to scale:
// at true scale a 20-second window on a two-hour recording would be invisible.
interface Props {
  stage: 'mark' | 'clip' | 'clean';
}
const { stage } = Astro.props;

// Seven marks; the second and third are close enough that their windows merge.
const marks = [4.98, 17.0, 18.3, 38.13, 54.18, 73.1, 92.05];
const windows = [
  { left: 2.58, width: 3.2 },
  { left: 14.6, width: 4.5 },
  { left: 35.73, width: 3.2 },
  { left: 51.78, width: 3.2 },
  { left: 70.7, width: 3.2 },
  { left: 89.65, width: 3.2 },
];
let cursor = 0;
const packed = windows.map((w) => {
  const at = cursor;
  cursor += w.width + 0.7;
  return { ...w, to: at };
});

const text = {
  mark: 'Diagram of the sample session after recording: a long grey strip of footage with seven red marks on it.',
  clip: 'Diagram of the sample session after Clip: the windows around the marks are lifted out of the recording and joined into a short reel.',
  clean: 'Diagram of the sample session after Clean: the original recording is gone, its space is free, and the reel is kept.',
}[stage];
---

<figure class={`strip strip--${stage}`} data-reveal>
  <div class="strip-rows" role="img" aria-label={text}>
    <div class="strip-row">
      <span class="strip-name">{stage === 'clean' ? 'Original' : 'Recording'}</span>
      <div class="strip-tape strip-tape--source">
        <div class="strip-footage"></div>
        {stage !== 'mark' && windows.map((w, i) => (
          <span class="strip-win" style={`left:${w.left}%;width:${w.width}%;--i:${i}`}></span>
        ))}
        {stage === 'mark' && marks.map((m, i) => (
          <span class="strip-mark" style={`left:${m}%;--i:${i}`}></span>
        ))}
        {stage === 'clean' && <span class="strip-freed">12.63 GB back</span>}
      </div>
      <span class="strip-meta">{stage === 'clean' ? 'Recycle Bin' : '2:14:07'}</span>
    </div>

    {stage !== 'mark' && (
      <div class="strip-row">
        <span class="strip-name">Reel</span>
        <div class="strip-tape strip-tape--reel">
          {packed.map((w, i) => (
            <span class="strip-clip" style={`--from:${w.left}%;--to:${w.to}%;width:${w.width}%;--i:${i}`}></span>
          ))}
        </div>
        <span class="strip-meta">2:17</span>
      </div>
    )}
  </div>
  <figcaption>
    {stage === 'mark' && <>Sample session after recording. <b class="c-red">7 marks</b>, no editing done yet, none needed.</>}
    {stage === 'clip' && <>Same session after Clip. <b class="c-yellow">6 clips and a reel</b>: two marks were close together, so their windows merged.</>}
    {stage === 'clean' && <>Same session after Clean. The original is in the Recycle Bin, <b class="c-green">the space is back</b>, the reel stays.</>}
    <span class="strip-scale">Diagram, not to scale.</span>
  </figcaption>
</figure>

<style>
  .strip { margin: 0; }
  .strip-rows { display: grid; gap: 0.6rem; }
  .strip-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) 5.5rem;
    align-items: center;
    gap: 1rem;
  }
  .strip-name, .strip-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .strip-meta { text-align: right; font-variant-numeric: tabular-nums; }
  .strip-tape { position: relative; height: 2.75rem; }
  .strip-tape--source { background: #131313; }
  .strip-tape--reel { background: transparent; box-shadow: inset 0 0 0 1px var(--rule); }
  .strip-footage {
    position: absolute;
    inset: 0;
    background-color: var(--footage);
    background-image: repeating-linear-gradient(to right, rgba(0, 0, 0, 0.28) 0 1px, transparent 1px 14px);
    transform-origin: right;
    transition: transform 1.1s cubic-bezier(0.6, 0, 0.2, 1) 0.5s, opacity 0.6s ease 0.5s;
  }

  .strip-mark {
    position: absolute;
    top: -0.5rem;
    bottom: 0;
    width: 3px;
    margin-left: -1.5px;
    background: var(--red);
    transform-origin: top;
  }
  .strip-mark::before {
    content: '';
    position: absolute;
    top: -0.15rem;
    left: 50%;
    width: 0.62rem;
    height: 0.6rem;
    margin-left: -0.31rem;
    border-radius: 0.09rem;
    background: var(--red);
  }

  .strip-win { position: absolute; top: 0; bottom: 0; background: var(--yellow); }
  .strip-clip {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--to);
    background: var(--yellow);
  }

  .strip-freed {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-left: 0.9rem;
    border: 1px dashed rgba(107, 229, 83, 0.55);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green);
    white-space: nowrap;
  }
  .strip--clean .strip-win { display: none; }
  .strip--clean .strip-footage { z-index: 1; }

  figcaption {
    margin-top: 0.9rem;
    padding-left: 6.5rem;
    font-size: 0.92rem;
    color: var(--ink-3);
  }
  figcaption b { font-weight: 650; }
  .c-red { color: var(--red); }
  .c-yellow { color: var(--yellow); }
  .c-green { color: var(--green); }
  .strip-scale { margin-left: 0.4em; opacity: 0.8; }

  /* Motion: each strip performs its stage once, when it scrolls into view. */
  :global(.js-reveal) .strip--mark:not(.is-in) .strip-mark { transform: scaleY(0); }
  :global(.js-reveal) .strip--mark .strip-mark {
    transition: transform 0.3s cubic-bezier(0.3, 1.4, 0.5, 1);
    transition-delay: calc(0.35s + var(--i) * 0.16s);
  }
  :global(.js-reveal) .strip--clip:not(.is-in) .strip-clip { left: var(--from); opacity: 0; }
  :global(.js-reveal) .strip--clip .strip-clip {
    transition: left 0.9s cubic-bezier(0.6, 0, 0.2, 1), opacity 0.3s ease;
    transition-delay: calc(0.5s + var(--i) * 0.1s);
  }
  .strip--clip .strip-win { background: color-mix(in srgb, var(--yellow) 42%, var(--footage)); }
  .strip--clean .strip-footage { transform: scaleX(0); opacity: 0; }
  :global(.js-reveal) .strip--clean:not(.is-in) .strip-footage { transform: scaleX(1); opacity: 1; }

  @media (max-width: 640px) {
    .strip-row { grid-template-columns: minmax(0, 1fr) auto; gap: 0.3rem 0.75rem; }
    .strip-name { grid-column: 1; }
    .strip-meta { grid-column: 2; grid-row: 1; }
    .strip-tape { grid-column: 1 / -1; height: 2.25rem; }
    .strip--mark .strip-tape { margin-top: 0.5rem; }
    figcaption { padding-left: 0; }
    .strip-scale { display: block; margin: 0.2rem 0 0; }
  }
</style>
