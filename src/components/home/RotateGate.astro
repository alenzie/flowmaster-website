---
// Full-screen "turn your phone" prompt for the homepage videos. Opened and
// closed by src/scripts/rotate-gate.ts; never shown on desktops or tablets.
// The wireframe phone turns sideways and the video on its screen fades in,
// after the portrait gate in kavi-portfolio.
---

<dialog class="rotate-gate" data-rotate-gate aria-labelledby="rotate-gate-title" aria-describedby="rotate-gate-text" tabindex="-1">
  <div class="rotate-gate-body">
    <h2 class="rotate-gate-title" id="rotate-gate-title">Turn your device sideways</h2>
    <svg class="rotate-gate-art" viewBox="0 0 260 220" fill="none" aria-hidden="true" focusable="false">
      <defs><clipPath id="rotate-gate-screen"><rect x="100" y="51" width="60" height="118" rx="9" /></clipPath></defs>
      <path class="rg-target" d="M58 80V68h12m120 0h12v12m0 60v12h-12m-120 0H58v-12" />
      <g class="rg-cue"><path pathLength="100" d="M142 27a84 84 0 0 1 72 77" /><path d="m208 99 6 7 5-8" /></g>
      <g class="rg-device">
        <path class="rg-buttons" d="M92 72v13m0 7v8m76-21v18" />
        <rect class="rg-shell" x="94" y="44" width="72" height="132" rx="15" />
        <rect class="rg-rim" x="100" y="51" width="60" height="118" rx="9" />
        <g clip-path="url(#rotate-gate-screen)">
          <g class="rg-video">
            <!-- Drawn landscape, turned to fit the upright screen; upright again once the phone turns. -->
            <g transform="rotate(-90 130 110)">
              <path class="rg-play" d="M124 99v20l16-10z" />
              <path class="rg-bar" d="M80 132h100" />
              <path class="rg-progress" d="M80 132h34" />
              <rect class="rg-mark rg-mark--r" x="96" y="129.5" width="5" height="5" rx="1" />
              <rect class="rg-mark rg-mark--y" x="132" y="129.5" width="5" height="5" rx="1" />
              <rect class="rg-mark rg-mark--g" x="162" y="129.5" width="5" height="5" rx="1" />
            </g>
          </g>
        </g>
        <path class="rg-detail" d="M124 57h12m-15 106h18" />
      </g>
    </svg>
    <p class="rotate-gate-text" id="rotate-gate-text">Flowmaster videos play in landscape.<br />Rotate your device to watch.</p>
    <button type="button" class="rotate-gate-close" data-rotate-close>Close the video</button>
  </div>
</dialog>

<style>
  .rotate-gate:not([open]) { display: none; }
  .rotate-gate[open] {
    display: grid;
    place-items: center;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: max(24px, env(safe-area-inset-top)) max(20px, env(safe-area-inset-right)) max(24px, env(safe-area-inset-bottom)) max(20px, env(safe-area-inset-left));
    border: 0;
    background: #050505;
    color: var(--ink);
    overflow: auto;
  }
  .rotate-gate::backdrop { background: #050505; }
  .rotate-gate:focus { outline: none; }
  .rotate-gate-body { display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 22rem; margin: auto; text-align: center; }
  .rotate-gate-title {
    margin: 0;
    font-family: var(--font-heading);
    font-stretch: 64%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.1rem, 10vw, 2.8rem);
    line-height: 0.92;
    color: var(--ink);
  }
  .rotate-gate-art { display: block; flex: none; width: 260px; max-width: 100%; height: 220px; margin: 1.25rem 0 0; overflow: visible; stroke-linecap: round; stroke-linejoin: round; }
  .rotate-gate-text { margin: 0.75rem 0 1.6rem; font-size: 0.98rem; line-height: 1.6; color: var(--ink-2); }
  .rotate-gate-close {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.75rem 1.3rem;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }
  .rotate-gate-close:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  .rg-target { stroke: var(--ink-3); stroke-width: 0.8; opacity: 0.6; }
  .rg-shell { stroke: var(--ink); stroke-width: 1.5; fill: #0b0b0b; }
  .rg-rim { stroke: var(--ink-3); stroke-width: 0.6; fill: #0b0b0b; }
  .rg-buttons { stroke: var(--ink-3); stroke-width: 1.8; }
  .rg-detail { stroke: var(--ink-3); stroke-width: 1.3; }
  .rg-cue { stroke: var(--ink-2); stroke-width: 1; opacity: 0; }
  .rg-play { fill: var(--ink); stroke: none; }
  .rg-bar { stroke: var(--ink-3); stroke-width: 1.2; }
  .rg-progress { stroke: var(--ink); stroke-width: 1.2; }
  .rg-mark { stroke: none; }
  .rg-mark--r { fill: var(--red); }
  .rg-mark--y { fill: var(--yellow); }
  .rg-mark--g { fill: var(--green); }
  .rg-device { transform-box: view-box; transform-origin: 130px 110px; transform: rotate(90deg); }
  .rotate-gate[open] .rg-device { animation: rg-turn 4.8s cubic-bezier(0.22, 0.68, 0.18, 1) infinite; }
  .rotate-gate[open] .rg-video { animation: rg-video 4.8s ease infinite; }
  .rotate-gate[open] .rg-cue { animation: rg-cue 4.8s ease infinite; }
  @keyframes rg-turn {
    0%, 16% { transform: rotate(0); opacity: 1; }
    48%, 82% { transform: rotate(90deg); opacity: 1; }
    90% { transform: rotate(90deg); opacity: 0; }
    91%, 95% { transform: rotate(0); opacity: 0; }
    100% { transform: rotate(0); opacity: 1; }
  }
  @keyframes rg-video { 0%, 44%, 90%, 100% { opacity: 0; } 58%, 82% { opacity: 1; } }
  @keyframes rg-cue { 0%, 4% { opacity: 0; } 12%, 24% { opacity: 0.7; } 40%, 100% { opacity: 0; } }
  @media (max-height: 640px) {
    .rotate-gate-art { width: 208px; height: 176px; margin-top: 0.75rem; }
    .rotate-gate-text { margin: 0.5rem 0 1.2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rotate-gate[open] .rg-device, .rotate-gate[open] .rg-video, .rotate-gate[open] .rg-cue { animation: none; }
    .rg-cue { display: none; }
  }
</style>
