---
// The Mark tab, rebuilt from the app source. Two uses:
//   live: the hero mockup. OBS is recording and the first session counts the
//         marks the visitor drops on the strip below it.
//   log:  the Mark chapter. The session is finished and its saved timestamps
//         are open (the app's "View Timestamps").
import AppWindow from './AppWindow.astro';
import { RECORDINGS, PRESET_MARKS, markLabel, timecode } from './session';

interface Props { variant: 'live' | 'log'; }
const { variant } = Astro.props;
const live = variant === 'live';
const rows = RECORDINGS.slice(0, live ? 2 : 3);
---
<AppWindow
  tab="mark"
  label={live ? 'The Flowmaster app during a recording, rebuilt for this page' : 'The Mark tab of the Flowmaster app, rebuilt for this page'}
  class={live ? 'fm--hero' : undefined}
>
  <div class="mark-tab" data-mark-window={variant}>
    <div class="mark-status-bar">
      <div class="obs-status">
        <span class="obs-dot connected" aria-hidden="true"></span>
        <span data-obs-text>{live ? 'OBS: Recording' : 'OBS: Connected'}</span>
      </div>
      <div class:list={['rec-indicator', { active: live }]} data-rec-ind>
        <div class="rec-squares" aria-hidden="true">
          <div class="rec-square red"></div>
          <div class="rec-square yellow"></div>
          <div class="rec-square green"></div>
        </div>
        <span class="rec-label" data-rec-label>{live ? 'REC' : 'IDLE'}</span>
      </div>
    </div>

    <div class="mark-section">
      <p class="section-title">Recent Sessions</p>
      <div class="scrollable-list">
        {rows.map((row, i) => (
          <>
            <div class="mark-session-item">
              <div class="session-left">
                <div class="row-thumb" aria-hidden="true"></div>
                <div class="session-info">
                  <div class="session-name">{row.file}</div>
                  <div class="session-meta">
                    <span class="mark-count" data-count={i === 0 ? '' : undefined}>{markLabel(i === 0 && live ? 0 : row.marks)}</span>
                    <span class="session-date">{row.date}</span>
                  </div>
                </div>
              </div>
              <span class="three-dot-btn" aria-hidden="true"><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>
            </div>
            {i === 0 && !live && (
              <div class="timestamp-popover" data-stamps>
                {PRESET_MARKS.map((mark, n) => <div class="mark-line">Mark {n + 1}: {timecode(mark)}</div>)}
              </div>
            )}
          </>
        ))}
      </div>
    </div>

    {!live && (
      <div class="mark-footer">
        <p class="help-text">Press <kbd>F9</kbd> during recording to create timestamp markers.</p>
      </div>
    )}
  </div>
</AppWindow>

<script>
  import { onTake, markLabel, timecode } from './session';

  // The finished session in the Mark chapter follows the take recorded in the hero.
  const log = document.querySelector<HTMLElement>('[data-mark-window="log"]');
  if (log) {
    const count = log.querySelector<HTMLElement>('[data-count]');
    const stamps = log.querySelector<HTMLElement>('[data-stamps]');
    const line = (text: string, fresh = false) => {
      const div = document.createElement('div');
      div.className = fresh ? 'mark-line is-new' : 'mark-line';
      div.textContent = text;
      return div;
    };
    onTake((take) => {
      if (count) count.textContent = markLabel(take.marks.length);
      if (stamps) stamps.replaceChildren(...take.marks.map((mark, n) => line(`Mark ${n + 1}: ${timecode(mark)}`)));
    });

    // â”€â”€ Live marks from the F9 key in the Mark chapter (MarkLoop's 'flowmaster:mark'). â”€â”€
    // The first press starts a new recording in the first row (named from the
    // visitor's clock); each press adds a timestamp line with the time under the
    // playhead. The list holds a fixed number of lines, so once it is full the
    // oldest slides off the top and the window keeps its shape.
    const MAX_LINES = 8;
    const DOCK_LINES = 4;
    const obsText = log.querySelector<HTMLElement>('[data-obs-text]');
    const recInd = log.querySelector<HTMLElement>('[data-rec-ind]');
    const recLabel = log.querySelector<HTMLElement>('[data-rec-label]');
    const firstRow = log.querySelector<HTMLElement>('.mark-session-item');
    let recording = false;
    let total = 0;
    let began = new Date();
    const pad = (n: number) => String(n).padStart(2, '0');

    const push = (list: HTMLElement, text: string, max: number) => {
      list.append(line(text, true));
      const lines = [...list.querySelectorAll<HTMLElement>('.mark-line:not(.is-leaving)')];
      lines.slice(0, Math.max(0, lines.length - max)).forEach((old) => {
        old.classList.add('is-leaving');
        window.setTimeout(() => old.remove(), 260);
      });
    };
    const bump = (el: HTMLElement | null | undefined, text: string) => {
      if (!el) return;
      el.textContent = text;
      el.classList.remove('is-bump');
      void el.offsetWidth;
      el.classList.add('is-bump');
    };

    // Phones: the list sits below the key, off screen. A slice of the window (the
    // session row and its latest lines) slides in while the visitor is pressing.
    const stacked = window.matchMedia('(max-width: 999px)');
    let dock: HTMLElement | null = null;
    let dockList: HTMLElement | null = null;
    let docked = false;
    let dockTimer = 0;
    const onScreen = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return r.top >= 0 && r.bottom <= window.innerHeight; };
    const buildDock = () => {
      if (dock || !firstRow || !stamps) return;
      dock = document.createElement('div');
      dock.className = 'fm mark-dock';
      dock.setAttribute('aria-hidden', 'true');
      const row = firstRow.cloneNode(true) as HTMLElement;
      dockList = document.createElement('div');
      dockList.className = 'timestamp-popover mark-dock-stamps';
      [...stamps.querySelectorAll('.mark-line:not(.is-leaving)')].slice(-DOCK_LINES).forEach((l) => dockList!.append(line(l.textContent || '')));
      dock.append(row, dockList);
      document.body.append(dock);
    };
    const undock = () => {
      window.clearTimeout(dockTimer);
      if (!dock || !docked) return;
      docked = false;
      dock.classList.remove('is-in');
    };
    const showDock = (anchor?: HTMLElement) => {
      window.clearTimeout(dockTimer);
      dockTimer = window.setTimeout(undock, 2600);
      if (docked || !stacked.matches || !stamps || onScreen(stamps)) return;
      if (!dock) {
        buildDock();
        void dock!.offsetWidth;
      }
      // Bottom of the screen, unless the key itself is down there.
      const keyLow = anchor ? anchor.getBoundingClientRect().bottom > window.innerHeight - dock!.offsetHeight - 40 : false;
      dock!.classList.toggle('is-top', keyLow);
      docked = true;
      requestAnimationFrame(() => dock!.classList.add('is-in'));
    };

    window.addEventListener('flowmaster:mark', (event) => {
      if (!stamps) return;
      const detail = (event as CustomEvent<{ anchor?: HTMLElement; at?: number }>).detail ?? {};
      const time = detail.time ?? 0;
      if (!recording) {
        recording = true;
        total = 0;
        stamps.replaceChildren();
        // A new recording: the phone slice is rebuilt from the fresh row on its next show.
        dock?.remove();
        dock = null;
        dockList = null;
        docked = false;
        began = new Date(Date.now() - time * 1000);
        const name = firstRow?.querySelector('.session-name');
        const date = firstRow?.querySelector('.session-date');
        if (name) name.textContent = `${began.getFullYear()}-${pad(began.getMonth() + 1)}-${pad(began.getDate())} ${pad(began.getHours())}-${pad(began.getMinutes())}-${pad(began.getSeconds())}.mp4`;
        if (date) date.textContent = 'Recording now';
        if (obsText) obsText.textContent = 'OBS: Recording';
        recInd?.classList.add('active');
        if (recLabel) recLabel.textContent = 'REC';
      }
      total += 1;
      const text = `Mark ${total}: ${timecode(time)}`;
      showDock(detail.anchor);
      push(stamps, text, MAX_LINES);
      bump(count, markLabel(total));
      if (dock && dockList) {
        push(dockList, text, DOCK_LINES);
        bump(dock.querySelector<HTMLElement>('[data-count]'), markLabel(total));
      }
    });
    // Stop recording in the Mark chapter: back to idle; the session keeps its marks.
    window.addEventListener('flowmaster:stop', () => {
      if (!recording) return;
      recording = false;
      if (obsText) obsText.textContent = 'OBS: Connected';
      recInd?.classList.remove('active');
      if (recLabel) recLabel.textContent = 'IDLE';
      const date = firstRow?.querySelector('.session-date');
      if (date) date.textContent = began.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
      dock?.querySelector('.session-date')?.replaceChildren(date?.textContent ?? '');
    });
    new IntersectionObserver(([entry]) => { if (!entry.isIntersecting) undock(); }).observe(document.querySelector('[data-mark-loop]') ?? log);
    stacked.addEventListener?.('change', undock);
  }
</script>
