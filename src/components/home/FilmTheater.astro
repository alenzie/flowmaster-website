---
// The Flowmaster film, as a theatre rather than a page section.
// A small "Watch the film" button opens a modal dialog: the page lights go down
// almost to black, then the screen swings up out of the dark and the film starts
// with sound (the click is the visitor's own, so the browser allows it).
// Escape, the close button or a click on the dark closes it and pauses the film.
// Staging follows the synth reveal in the portfolio (portfolio26, SynthReveal.astro).
interface Props { class?: string }
const { class: className = '' } = Astro.props;
const film = '/media/flowmaster/film-v26';
---

<button type="button" class:list={['film-trigger', className]} data-film-open aria-haspopup="dialog" aria-controls="film-theater">
  <span class="film-trigger-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 3.2v9.6L12.6 8z" /></svg></span>
  <span>Watch the film</span>
  <span class="film-trigger-len">1:30</span>
</button>

<dialog class="theater" id="film-theater" aria-label="The Flowmaster film" data-film-dialog>
  <div class="theater-lights" data-film-lights></div>
  <div class="theater-stage">
    <div class="theater-screen" data-film-screen>
      <video class="theater-video" controls playsinline preload="none" poster={`${film}-poster.jpg`} data-film-video>
        <source src={`${film}.mp4`} type="video/mp4" />
        <track kind="captions" src={`${film}.en.vtt`} srclang="en" label="English" />
        <p>Your browser cannot play this film. <a href={`${film}.mp4`}>Open the Flowmaster film.</a></p>
      </video>
    </div>
    <p class="theater-cap label"><span>The Flowmaster film</span><span>1:30 &middot; has sound</span></p>
  </div>
  <button type="button" class="theater-close" data-film-close aria-label="Close the film">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" /></svg>
  </button>
</dialog>

<style>
  /* ---------- Trigger ---------- */
  .film-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3.4rem;
    padding: 0.55rem 1.1rem 0.55rem 0.55rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .film-trigger:hover { border-color: var(--ink-2); background: rgba(255, 255, 255, 0.04); }
  .film-trigger:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .film-trigger-icon {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 0 rgba(244, 63, 67, 0.45);
    transition: box-shadow 0.3s ease;
  }
  .film-trigger:hover .film-trigger-icon { box-shadow: 0 0 0 6px rgba(244, 63, 67, 0.16); }
  .film-trigger-icon svg { width: 0.95rem; height: 0.95rem; margin-left: 2px; fill: #140606; }
  .film-trigger-len { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 500; color: var(--ink-3); }

  /* ---------- Theatre ---------- */
  .theater {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: hidden;
  }
  .theater::backdrop { background: transparent; }
  .theater-lights {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 55%, #0b0c0f 0%, #030405 70%);
    opacity: 0;
    transition: opacity 1.4s ease-in-out;
  }
  .theater.is-open .theater-lights { opacity: 0.985; }

  .theater-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    padding: clamp(1rem, 5vw, 4.5rem);
    perspective: 1600px;
    pointer-events: none;
  }
  .theater-screen {
    position: relative;
    width: min(100%, calc((100dvh - 9rem) * 16 / 9), 1400px);
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 60px 140px -30px rgba(0, 0, 0, 0.95),
      0 0 120px -20px rgba(244, 63, 67, 0.22);
    transform-origin: 50% 100%;
    transform: translateY(18vh) rotateX(28deg) scale(0.86);
    opacity: 0;
    transition: transform 0.7s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.5s ease;
    pointer-events: auto;
  }
  .theater.is-open .theater-screen {
    transform: none;
    opacity: 1;
    transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.55s, opacity 0.8s ease 0.55s;
  }
  .theater-video { display: block; width: 100%; height: 100%; background: #000; }
  .theater-cap {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(100%, calc((100dvh - 9rem) * 16 / 9), 1400px);
    font-size: 0.68rem;
    color: var(--ink-3);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .theater.is-open .theater-cap { opacity: 1; transition: opacity 0.8s ease 1.6s; }

  .theater-close {
    position: absolute;
    top: clamp(0.9rem, 2.5vw, 1.6rem);
    right: clamp(0.9rem, 2.5vw, 1.6rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid rgba(242, 240, 234, 0.28);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.4);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.3s ease, border-color 0.2s ease;
  }
  .theater.is-open .theater-close { opacity: 1; transition: opacity 0.6s ease 1s, border-color 0.2s ease; }
  .theater-close:hover { border-color: var(--ink); }
  .theater-close:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .theater-close svg { width: 0.95rem; height: 0.95rem; stroke: var(--ink); stroke-width: 1.8; stroke-linecap: round; fill: none; }

  @media (prefers-reduced-motion: reduce) {
    .theater-lights, .theater-screen, .theater-cap, .theater-close,
    .theater.is-open .theater-lights, .theater.is-open .theater-screen,
    .theater.is-open .theater-cap, .theater.is-open .theater-close { transition: none; }
    .theater-screen { transform: none; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-film-dialog]');
  const video = dialog?.querySelector<HTMLVideoElement>('[data-film-video]');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-film-close]');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-film-open]')];
  if (dialog && video && closeButton) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let lastTrigger: HTMLElement | null = null;
    let timers: number[] = [];
    let previousOverflow = '';
    const clear = () => { timers.forEach((id) => window.clearTimeout(id)); timers = []; };

    function open(trigger: HTMLElement) {
      if (dialog!.open) return;
      clear();
      lastTrigger = trigger;
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      // Stop any other sound on the page first.
      document.querySelectorAll('video, audio').forEach((m) => { if (m !== video) (m as HTMLMediaElement).pause(); });
      dialog!.showModal();
      closeButton!.focus();
      video!.preload = 'auto';
      requestAnimationFrame(() => requestAnimationFrame(() => dialog!.classList.add('is-open')));
      // Start once the screen has risen; the click that opened it allows sound.
      timers.push(window.setTimeout(() => { video!.play().catch(() => {}); }, reduced.matches ? 0 : 1700));
    }

    function close() {
      if (!dialog!.open) return;
      clear();
      video!.pause();
      dialog!.classList.remove('is-open');
      timers.push(window.setTimeout(() => {
        dialog!.close();
        document.body.style.overflow = previousOverflow;
        lastTrigger?.focus();
      }, reduced.matches ? 0 : 750));
    }

    triggers.forEach((t) => t.addEventListener('click', () => open(t)));
    closeButton.addEventListener('click', close);
    dialog.querySelector('[data-film-lights]')?.addEventListener('click', close);
    dialog.addEventListener('cancel', (event) => { event.preventDefault(); close(); });
    video.addEventListener('ended', () => { timers.push(window.setTimeout(close, 1200)); });
  }
</script>
