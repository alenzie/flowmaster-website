---
const currentYear = new Date().getFullYear();

const productLinks = [
  { href: '/account', label: 'Create a free account' },
  { href: '/download', label: 'Download' },
  { href: '/pricing', label: 'Free trial' },
  { href: '/docs', label: 'Docs' },
  { href: '/future', label: 'Future' },
];

const smallPrint = [
  { href: '/data', label: 'Trial data' },
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms of Service' },
];

const contact = [
  { href: 'https://discord.gg/S8uJpcK3qJ', label: 'Discord' },
  { href: 'mailto:support@flowmastersuite.com', label: 'support@flowmastersuite.com' },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/brand/LogoHorizontalLockup.svg" alt="Flowmaster" width="176" height="80" loading="lazy" />
        <p>Record everything. Keep only what you meant to keep.</p>
      </div>

      <nav class="footer-col" aria-label="Product">
        <h2 class="label">Flowmaster</h2>
        <ul>
          {productLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Policies">
        <h2 class="label">The small print</h2>
        <ul>
          {smallPrint.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="label">Talk to me</h2>
        <ul>
          {contact.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        Made by Alexander Blair. An
        <a href="https://alenzie.com" target="_blank" rel="noopener noreferrer">Alenzie</a> product.
      </p>
      <p>&copy; {currentYear} Alenzie Solutions. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    background: #0b0b0b;
    padding: 4rem 0 2rem;
  }
  .footer-top {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1fr 1fr;
  }
  .footer-brand { grid-column: 1 / -1; }
  .footer-brand img { width: 9.5rem; height: auto; }
  .footer-brand p {
    margin-top: 1.25rem;
    max-width: 18rem;
    font-size: 0.95rem;
    color: var(--ink-3);
  }
  .footer-col h2 {
    font-family: var(--font-mono);
    font-stretch: 100%;
    margin-bottom: 0.9rem;
  }
  .footer-col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.15rem; }
  .footer-col a {
    display: inline-block;
    padding: 0.4rem 0;
    color: var(--ink-2);
    font-size: 0.97rem;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .footer-col a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 0.25em; }

  .footer-bottom {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  .footer-bottom p { font-size: 0.85rem; color: var(--ink-3); }
  .footer-bottom a { color: var(--color-alenzie-mint); text-decoration: none; }
  .footer-bottom a:hover { text-decoration: underline; }

  @media (min-width: 900px) {
    .footer-top { grid-template-columns: 1.6fr 1fr 1fr 1.2fr; }
    .footer-brand { grid-column: auto; }
  }
</style>
