---

const productLinks = [
  { href: '/download', label: 'Download' },
  { href: '/pricing', label: 'Free trial' },
  { href: '/account', label: 'Account' },
  { href: '/docs', label: 'Docs' },
  { href: '/future', label: 'Future' },
];

const legalLinks = [
  { href: '/data', label: 'Trial data' },
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms of Service' },
];

const contactLinks = [
  { href: 'https://discord.gg/S8uJpcK3qJ', label: 'Discord' },
  { href: 'mailto:support@flowmastersuite.com', label: 'support@flowmastersuite.com' },
];
---

<footer class="site-foot">
  <!-- The top edge of the footer is drawn as a timeline ruler. -->
  <div class="foot-ruler" aria-hidden="true"></div>
  <div class="wrap foot-inner">
    <div class="foot-brand">
      <a href="/" aria-label="Flowmaster home">
        <img src="/brand/LogoHorizontalLockup-LiveEditor.svg" alt="Flowmaster Live Editor" width="176" height="80" loading="lazy" />
      </a>
      <p>Mark it, clip it, clean it.</p>
    </div>

    <nav class="foot-col" aria-label="Product">
      <h2 class="label">Product</h2>
      <ul>
        {productLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <nav class="foot-col" aria-label="Legal">
      <h2 class="label">Legal</h2>
      <ul>
        {legalLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <nav class="foot-col foot-contact" aria-label="Contact">
      <h2 class="label">Contact</h2>
      <ul>
        {contactLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

</footer>

<style>
  .site-foot { background: #0c0c0c; }
  .foot-ruler {
    height: 14px;
    border-top: 1px solid var(--rule-strong);
    background-image:
      repeating-linear-gradient(to right, var(--rule-strong) 0 1px, transparent 1px 60px),
      repeating-linear-gradient(to right, var(--rule) 0 1px, transparent 1px 12px);
    background-size: auto 14px, auto 6px;
    background-repeat: repeat-x;
    -webkit-mask-image: linear-gradient(to right, #000 60%, transparent);
    mask-image: linear-gradient(to right, #000 60%, transparent);
  }
  .foot-inner {
    padding: clamp(2.5rem, 6vw, 4rem) 0 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem 2rem;
  }
  .foot-brand { grid-column: 1 / -1; }
  .foot-brand img { width: 176px; height: auto; display: block; margin-bottom: 1.1rem; }
  .foot-brand p { margin: 0; color: var(--ink-2); font-size: 0.95rem; }

  .foot-col h2 { margin: 0 0 0.9rem; font-stretch: 100%; font-size: 0.7rem; letter-spacing: 0.13em; }
  .foot-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .foot-col a { display: inline-block; padding: 0.3rem 0; color: var(--ink-2); font-size: 0.95rem; text-decoration: none; overflow-wrap: anywhere; }
  .foot-col a:hover { color: var(--ink); }


  .foot-contact { grid-column: 1 / -1; }

  @media (min-width: 820px) {
    .foot-inner { grid-template-columns: minmax(0, 1.7fr) repeat(3, minmax(0, 1fr)); }
    .foot-brand, .foot-contact { grid-column: auto; }
  }
</style>
