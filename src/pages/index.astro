---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import MarkWindow from '../components/home/MarkWindow.astro';
import MarkLoop from '../components/home/MarkLoop.astro';
import { LOOKBACK, LOOKFORWARD, formatDuration } from '../components/home/session';
import PitchClip from '../components/home/PitchClip.astro';
import ChapterClip from '../components/home/ChapterClip.astro';
import ChapterClean from '../components/home/ChapterClean.astro';
import FilmTheater from '../components/home/FilmTheater.astro';
import release from '../data/release.json';

// Same test the download page uses. While the download is closed, nothing on
// this page may suggest the installer can be had today.
const downloadOpen = release.available && !!release.downloadUrl && !!release.sha256;

// Hero: an example session drawn to scale. Eleven marks, each keeping LOOKBACK
// seconds before and LOOKFORWARD after, spaced so no two windows overlap.
const HERO_TOTAL = 3 * 3600 + 12 * 60 + 8; // 3:12:08
const HERO_KEPT = [0.06, 0.14, 0.21, 0.33, 0.41, 0.47, 0.58, 0.69, 0.76, 0.85, 0.94].map((f) => Math.round(HERO_TOTAL * f));
const HERO_KEEP = HERO_KEPT.length * (LOOKBACK + LOOKFORWARD); // 12:50

---

<BaseLayout title="Never do the rough cut">
  <!-- HERO: the headline, and what a session looks like before and after -->
  <section id="hero" class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-pitch">
        <p class="label hero-eyebrow">
          <img src="/brand/LogoEmblem.svg" alt="" width="44" height="12" />
          Works with OBS Studio, on Windows
        </p>
        <h1 id="hero-title" class="hero-title">Never do the rough&nbsp;cut<span class="hero-stop" aria-hidden="true"></span><span class="sr-only">.</span></h1>
        <p class="hero-lede">Mark the moments while you record. Flowmaster keeps them and drops the rest.</p>
        <div class="hero-actions">
          <a class="btn-primary hero-cta" href="/account">Create a free account</a>
          <FilmTheater />
        </div>
        <p class="hero-more"><a class="arrow-link" href="/download">Download and trial details</a></p>
        <p class="hero-fine">
          {downloadOpen
            ? <>Free account, 30 actions per PC, no time limit, no payment card.</>
            : <>The download isn’t open yet. Your free account is ready when it is.</>}
        </p>
      </div>

      <figure class="hero-bars" aria-labelledby="hero-bars-cap">
        <div class="hb-row">
          <p class="hb-meta"><span class="label">Recorded</span><strong>{formatDuration(HERO_TOTAL)}</strong></p>
          <div class="hb-bar hb-bar--rec">
            {HERO_KEPT.map((at, i) => <i style={`--i:${i};left:${((at - LOOKBACK) / HERO_TOTAL) * 100}%;width:${((LOOKBACK + LOOKFORWARD) / HERO_TOTAL) * 100}%`}></i>)}
          </div>
        </div>
        <div class="hb-row">
          <p class="hb-meta"><span class="label hb-kept">Kept</span><strong class="hb-kept">{formatDuration(HERO_KEEP)}</strong></p>
          <div class="hb-bar hb-bar--kept"><i style={`width:${(HERO_KEEP / HERO_TOTAL) * 100}%`}></i></div>
        </div>
        <figcaption id="hero-bars-cap" class="label hb-cap">
          <span>Example session &middot; {HERO_KEPT.length} marks &middot; drawn to scale</span>
          <span>{LOOKBACK} s before and {LOOKFORWARD} s after each mark</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- WHERE IT STARTED: a clip from the first pitch -->
  <PitchClip />

  <!-- MARK -->
  <section class="chapter chapter--mark" id="mark" aria-labelledby="mark-title">
    <div class="wrap chapter-grid chapter-grid--flip">
      <div class="chapter-copy" data-reveal>
        <p class="chapter-tag">
          <img src="/brand/RedBox.svg" alt="" width="26" height="25" />
          <span class="chapter-num">01</span>
          <span class="chapter-name">Mark</span>
          <span class="chapter-when">While you record</span>
        </p>
        <h2 id="mark-title" class="display chapter-title">Press F9. Keep recording<span class="stop" aria-hidden="true"></span><span class="sr-only">.</span></h2>
        <p class="chapter-body">
          Flowmaster sits next to OBS Studio and waits for one key. When something happens that you would want in the video, press F9. It saves the timestamp and you carry on. There is nothing to name, nothing to trim and nothing to decide later.
        </p>
        <MarkLoop />
        <ul class="chapter-facts">
          <li><strong>F9 is the default.</strong> You can change the mark key in Settings.</li>
          <li><strong>It talks to OBS directly.</strong> Flowmaster connects through OBS&rsquo;s own WebSocket server.</li>
          <li><strong>Every session is listed.</strong> Each recording shows up in the Mark tab with its marks and their timestamps.</li>
        </ul>
      </div>
      <figure class="chapter-app" data-reveal style="--reveal-delay:.12s">
        <MarkWindow variant="log" />
        <figcaption class="label"><span>Mark tab, rebuilt in HTML</span><span>The first session is the one from the hero</span></figcaption>
      </figure>
    </div>
  </section>

  <ChapterClip />
  <ChapterClean />

  <!-- IN DEVELOPMENT -->
  <section class="next" aria-label="In development">
    <div class="wrap next-row" data-reveal>
      <span class="next-tag label">In development</span>
      <p>Events and Flow AI are in development for the December release.</p>
      <a class="arrow-link" href="/future">See what is planned</a>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="closing" aria-labelledby="closing-title">
    <div class="wrap closing-grid" data-reveal>
      <h2 id="closing-title" class="display closing-title"><span>Record everything.</span> Keep only what you meant to keep.</h2>
      <div class="closing-side">
        <div class="closing-actions">
          <a class="btn-primary hero-cta" href="/account">Create a free account</a>
          <a class="arrow-link" href="/download">Download and trial details</a>
        </div>
        <p class="hero-fine">
          {downloadOpen
            ? <>Free account. 30 actions per PC, no time limit, no payment card. Windows 10 and 11, 64-bit.</>
            : <>The Windows download is not open yet. Your free account is ready for it when it opens. No payment card.</>}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nowrap { white-space: nowrap; }

  /* ---------- Hero ---------- */
  .hero { padding: calc(var(--nav-h) + clamp(2.5rem, 6vw, 5.5rem)) 0 clamp(3.5rem, 7vw, 6rem); border-bottom: 1px solid var(--rule); }
  .hero-grid { display: grid; gap: clamp(2.75rem, 5vw, 4rem); align-items: center; }
  .hero-eyebrow { display: flex; align-items: center; gap: 0.8rem; }
  .hero-eyebrow img { width: 2.75rem; height: auto; flex: none; }
  .hero-title {
    margin-top: 1.1rem;
    font-family: var(--font-heading);
    font-stretch: 100%;
    font-weight: 700;
    font-size: clamp(2.7rem, 5.6vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-transform: none;
    color: var(--ink);
    text-wrap: balance;
  }
  .hero-stop {
    display: inline-block;
    width: 0.17em;
    height: 0.17em;
    margin-left: 0.04em;
    border-radius: 0.02em;
    background: var(--red);
  }
  .hero-lede { margin-top: 1.1rem; max-width: 30rem; font-size: clamp(1.1rem, 1.45vw, 1.25rem); line-height: 1.5; color: var(--ink-2); }
  .hero-actions, .closing-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 1.6rem;
  }
  .hero-cta { min-height: 3.4rem; padding: 0.9rem 1.6rem; font-size: 1.08rem; }
  .hero-more { margin-top: 1.1rem; }
  .hero-fine { margin-top: 0.9rem; font-size: 0.9rem; color: var(--ink-3); }

  /* Before and after, at true scale */
  .hero-bars { margin: 0; display: grid; gap: 1.6rem; min-width: 0; }
  .hb-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 0.55rem; }
  .hb-meta strong { font-family: var(--font-mono); font-size: clamp(1.4rem, 2.4vw, 2rem); font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
  .hb-kept { color: var(--yellow) !important; }
  .hb-bar { position: relative; height: clamp(2.6rem, 4vw, 3.4rem); }
  .hb-bar--rec {
    background-color: var(--footage);
    background-image: repeating-linear-gradient(to right, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 10px);
    transform-origin: left;
    animation: hb-grow 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s both;
  }
  .hb-bar--rec i {
    position: absolute;
    top: 0;
    bottom: 0;
    min-width: 3px;
    background: var(--yellow);
    /* Marks land left to right in red, hold, then turn yellow as the kept time appears. */
    animation:
      hb-mark 0.3s cubic-bezier(0.3, 1.4, 0.5, 1) calc(1.3s + var(--i) * 0.13s) both,
      hb-keep 0.4s ease 3.9s both;
  }
  .hb-bar--kept { box-shadow: inset 0 0 0 1px var(--rule); }
  .hb-bar--kept i {
    position: absolute;
    inset: 0 auto 0 0;
    min-width: 6px;
    background: var(--yellow);
    transform-origin: left;
    animation: hb-grow 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) 3.9s both;
  }
  .hb-cap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.3rem 1.5rem; margin-top: -0.4rem; font-size: 0.68rem; }
  .hb-row:nth-child(2) .hb-meta { animation: hb-in 0.5s ease 3.9s both; }
  @keyframes hb-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes hb-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes hb-mark { from { opacity: 0; transform: scaleY(0); background: var(--red); } to { opacity: 1; transform: scaleY(1); background: var(--red); } }
  @keyframes hb-keep { from { background: var(--red); } to { background: var(--yellow); } }
  @media (prefers-reduced-motion: reduce) {
    .hb-bar--rec, .hb-bar--rec i, .hb-bar--kept i, .hb-row:nth-child(2) .hb-meta { animation: none; }
  }
  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(3rem, 7vw, 7rem); }
  }

  #mark :global(.mark-loop) { margin-top: 1.75rem; max-width: 33rem; }

  /* ---------- In development ---------- */
  .next { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .next-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; padding: 1.4rem 0; }
  .next-tag { padding: 0.3rem 0.6rem; border: 1px solid var(--rule-strong); border-radius: 4px; color: var(--ink-2); }
  .next-row p { flex: 1 1 20rem; color: var(--ink); }

  /* ---------- Closing ---------- */
  .closing { padding: clamp(4rem, 8vw, 6.5rem) 0; }
  .closing-grid { display: grid; gap: 2rem; }
  .closing-title { font-size: clamp(2.7rem, 6vw, 5.4rem); line-height: 0.88; font-stretch: 62%; }
  .closing-title span { display: block; color: var(--ink-3); }
  .closing-actions { margin-top: 0; }
  @media (min-width: 1000px) {
    .closing-grid { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 4rem; align-items: end; }
    .closing-side { padding-bottom: 0.4rem; }
  }
</style>
