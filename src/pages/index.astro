---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import MarkWindow from '../components/home/MarkWindow.astro';
import MarkLoop from '../components/home/MarkLoop.astro';
import ChapterClip from '../components/home/ChapterClip.astro';
import ChapterClean from '../components/home/ChapterClean.astro';
import FilmTheater from '../components/home/FilmTheater.astro';
import SessionBars from '../components/home/SessionBars.astro';
import Walkthrough from '../components/home/Walkthrough.astro';
import HeroLogo from '../components/home/HeroLogo.astro';



---

<BaseLayout title="Never do the rough cut">
  <!-- HERO: the headline, the actions, and the logo as the page's identifier -->
  <section id="hero" class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-pitch">
        <div class="hero-animate" style="--delay: 0.3s">
          <div class="hero-headline">
            <span class="display hero-title hero-title-shadow" aria-hidden="true">Never do the rough&nbsp;cut<span class="hero-stop"></span></span>
            <h1 id="hero-title" class="display hero-title hero-title-primary">Never <span class="hero-dim">do the</span> rough&nbsp;cut<span class="hero-stop" aria-hidden="true"></span><span class="sr-only">.</span></h1>
          </div>
        </div>
        <p class="hero-lede hero-animate" style="--delay: 0.5s">Choose what to keep. Not when to record.<br />Mark it, clip it, clean it.</p>
        <div class="hero-actions hero-animate" style="--delay: 0.7s">
          <a class="btn-primary hero-cta" href="/account">Create a free account</a>
          <FilmTheater />
        </div>
        <p class="hero-fine hero-animate" style="--delay: 0.9s">Free to use &bull; Windows 10/11</p>
      </div>

      <div class="hero-logo"><HeroLogo /></div>
    </div>

    <a href="#mark" class="hero-scroll hero-animate" style="--delay: 1.1s" aria-label="Scroll to learn more">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
    </a>
  </section>


  <!-- MARK -->
  <section class="chapter chapter--mark" id="mark" aria-labelledby="mark-title">
    <div class="wrap chapter-grid chapter-grid--flip">
      <div class="chapter-copy" data-reveal>
        <p class="chapter-tag">
          <img src="/brand/RedBox.svg" alt="" width="26" height="25" />
          <span class="chapter-num">01</span>
          <span class="chapter-name">Mark</span>
          <span class="chapter-when">While you record</span>
        </p>
        <h2 id="mark-title" class="display chapter-title">Press F9. Keep recording<span class="stop" aria-hidden="true"></span><span class="sr-only">.</span></h2>
        <p class="chapter-body">
          Flowmaster sits next to OBS Studio and waits for one key. When something happens that you would want in the video, press F9. It saves the timestamp and you carry on. There is nothing to name, nothing to trim and nothing to decide later.
        </p>
        <MarkLoop />
        <ul class="chapter-facts">
          <li><strong>F9 is the default.</strong> You can change the mark key in Settings.</li>
          <li><strong>It talks to OBS directly.</strong> Flowmaster connects through OBS&rsquo;s own WebSocket server.</li>
        </ul>
      </div>
      <figure class="chapter-app" data-reveal style="--reveal-delay:.12s">
        <MarkWindow variant="log" />
      </figure>
    </div>
  </section>

  <ChapterClip />
  <ChapterClean />

  <!-- HOW IT WORKS: the 1:48 walkthrough -->
  <Walkthrough />


  <!-- IN DEVELOPMENT -->
  <section class="next" aria-label="In development">
    <div class="wrap next-row" data-reveal>
      <span class="next-tag label">In development</span>
      <p>Events and Flow AI are in development for the December release.</p>
      <a class="arrow-link" href="/future">See what is planned</a>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="closing" aria-labelledby="closing-title">
    <div class="wrap closing-grid" data-reveal>
      <h2 id="closing-title" class="display closing-title"><span>Record everything.</span> Stress nothing.</h2>
      <div class="closing-bars"><SessionBars /></div>
      <div class="closing-side">
        <div class="closing-actions">
          <a class="btn-primary hero-cta" href="/account">Create a free account</a>
          <a class="arrow-link" href="/download">Download and trial details</a>
        </div>
        <p class="hero-fine">Free to use &bull; Windows 10/11</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nowrap { white-space: nowrap; }

  /* ---------- Hero ---------- */
  .hero { min-height: 100svh; display: grid; align-items: center; padding: clamp(5rem, 10vh, 7rem) 0; border-bottom: 1px solid var(--rule); }
  .hero-grid { display: grid; gap: clamp(2.75rem, 5vw, 4rem); align-items: center; }
  /* Same face as the section titles (.display): condensed, heavy, uppercase. */
  .hero-title {
    margin-top: 0;
    font-size: clamp(3rem, 6.4vw, 5.75rem);
  }
  .hero-stop {
    display: inline-block;
    width: 0.17em;
    height: 0.17em;
    margin-left: 0.04em;
    border-radius: 0.02em;
    background: currentColor;
  }
  .hero-lede { margin-top: 1.1rem; max-width: 30rem; font-size: clamp(1.1rem, 1.45vw, 1.25rem); line-height: 1.5; color: var(--ink-2); }
  .hero-actions, .closing-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 1.6rem;
  }
  .hero-cta { min-height: 3.4rem; padding: 0.9rem 1.6rem; font-size: 1.08rem; }
  .hero-fine { margin-top: 0.9rem; font-size: 0.9rem; color: var(--ink-3); }


  /* The logo is the page's identifier until the nav appears on scroll. */
  .hero-logo { display: flex; justify-content: center; align-items: center; }
  .hero { position: relative; }

  /* Ported from the original hero: staggered entrance, swaying headline over a
     shadow copy, and a bouncing scroll cue. */
  .hero-animate { opacity: 0; animation: hero-fade-in 0.8s ease-out forwards; animation-delay: var(--delay, 0s); }
  @keyframes hero-fade-in { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  .hero-headline { position: relative; display: inline-block; }
  .hero-title-shadow { position: absolute; inset: 0 0 auto 0; z-index: 1; color: rgba(20, 15, 12, 0.8); animation: sway-shadow 6s ease-in-out infinite; user-select: none; pointer-events: none; }
  .hero-title-shadow .hero-stop { background: rgba(20, 15, 12, 0.8); }
  /* "do the" steps back, the way "Not when to record" does in the pitch title. */
  .hero-dim { color: var(--ink-3); }
  .hero-title-primary { position: relative; z-index: 2; animation: sway-primary 6s ease-in-out infinite; }
  @keyframes sway-primary { 0%, 100% { transform: translate(0, 0); } 25% { transform: translate(4px, -2px); } 50% { transform: translate(0, -3px); } 75% { transform: translate(-4px, -1px); } }
  @keyframes sway-shadow { 0%, 100% { transform: translate(0, 0); } 25% { transform: translate(1px, -0.5px); } 50% { transform: translate(0, -1px); } 75% { transform: translate(-1px, -0.5px); } }
  .hero-scroll { position: absolute; bottom: 2rem; left: 50%; translate: -50% 0; display: block; width: 1.5rem; color: var(--ink-3); }
  .hero-scroll svg { display: block; width: 100%; animation: hero-bounce 2s ease-in-out infinite; }
  .hero-scroll:hover { color: var(--ink-2); }
  @keyframes hero-bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @media (prefers-reduced-motion: reduce) {
    .hero-animate { opacity: 1; animation: none; }
    .hero-title-shadow, .hero-title-primary, .hero-scroll svg { animation: none; }
  }
  @media (max-width: 899px) {
    .hero-logo { order: -1; }
    .hero-headline { display: block; }
  }
  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(3rem, 7vw, 7rem); }
  }

  #mark :global(.mark-loop) { margin-top: 1.75rem; max-width: 33rem; }

  /* ---------- In development ---------- */
  .next { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .next-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; padding: 1.4rem 0; }
  .next-tag { padding: 0.3rem 0.6rem; border: 1px solid var(--rule-strong); border-radius: 4px; color: var(--ink-2); }
  .next-row p { flex: 1 1 20rem; color: var(--ink); }

  /* ---------- Closing ---------- */
  .closing { padding: clamp(4rem, 8vw, 6.5rem) 0; }
  .closing-grid { display: grid; gap: 2rem; }
  .closing-title { font-size: clamp(2.7rem, 6vw, 5.4rem); line-height: 0.88; font-stretch: 62%; }
  .closing-title span { display: block; color: var(--ink-3); }
  .closing-actions { margin-top: 0; }
  /* The bars draw the headline: what was recorded, and what was kept. */
  .closing-bars :global(.hero-bars) { margin: 0; max-width: none; }
  @media (min-width: 1000px) {
    .closing-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 3rem 5rem; align-items: center; }
    .closing-title { grid-column: 1; grid-row: 1; }
    .closing-bars { grid-column: 2; grid-row: 1 / span 2; }
    .closing-side { grid-column: 1; grid-row: 2; }
  }
</style>
