---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FlowmasterFilm from '../components/FlowmasterFilm.astro';
import WorkflowDemo from '../components/WorkflowDemo.astro';
import LiveStats from '../components/LiveStats.astro';
import ThreeStepAnimation from '../components/ThreeStepAnimation.astro';
import FeaturesPreview from '../components/FeaturesPreview.astro';
import FuturePreview from '../components/FuturePreview.astro';
import Testimonials from '../components/Testimonials.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout title="Home">
  <Hero />
  <FlowmasterFilm />
  {/* Live usage stats — hidden until we have more users. Re-enable by uncommenting. */}
  {/* <LiveStats /> */}
  <ThreeStepAnimation />
  <FeaturesPreview />
  {/* The step-by-step walkthrough sits after the features, so the film and it aren't back to back. */}
  <WorkflowDemo />
  <FuturePreview />
  {/* Testimonials + "Watch Creator Stories" video — hidden until ready. Re-enable by uncommenting. */}
  {/* <Testimonials /> */}
  <CTASection />
</BaseLayout>
