---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import LiveStrip from '../components/home/LiveStrip.astro';
import MarkWindow from '../components/home/MarkWindow.astro';
import PitchClip from '../components/home/PitchClip.astro';
import ChapterClip from '../components/home/ChapterClip.astro';
import ChapterClean from '../components/home/ChapterClean.astro';
import FlowmasterFilm from '../components/FlowmasterFilm.astro';
import release from '../data/release.json';

// Same test the download page uses. While the download is closed, nothing on
// this page may suggest the installer can be had today.
const downloadOpen = release.available && !!release.downloadUrl && !!release.sha256;

const specs = [
  ['Runs on', 'Windows 10 and 11, 64-bit. There are no builds for other platforms.'],
  ['Works with', 'OBS Studio, connected through OBS’s WebSocket server.'],
  ['Mark key', 'F9 by default. Change it in Settings.'],
  ['Recordings', 'MP4. If OBS saved MKV, use OBS File → Remux Recordings to make MP4 first.'],
  ['You get', 'A reel, separate clips, or both, as MP4.'],
  ['Cleanup', 'Selected originals go to the Windows Recycle Bin.'],
  ['Bundled', 'FFmpeg and FFprobe are included with the app.'],
  ['Account', 'Free, and required. Sign in with email or Google.'],
  ['Trial', '30 actions per PC. No time limit. No payment card.'],
  ['Paid plans', 'None. Paid trials and upgrades are currently unavailable.'],
  ['Online', 'The trial is verified online, so starting new work needs an internet connection.'],
  ['Installer', 'Unsigned. Windows may show an unknown-publisher warning.'],
];
---

<BaseLayout title="Never do the rough cut">
  <!-- HERO: the headline, the app, and a recording you can mark, clip and clean -->
  <section id="hero" class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-wrap">
      <p class="label hero-eyebrow">
        <img src="/brand/LogoEmblem.svg" alt="" width="44" height="12" />
        Works with OBS Studio, on Windows
      </p>

      <h1 id="hero-title" class="display hero-title">Never do the <span class="nowrap">rough cut<span class="hero-stop" aria-hidden="true"></span></span></h1>

      <div class="hero-cols">
        <div class="hero-pitch">
          <dl class="hero-def">
            <dt><span class="hero-def-term">rough cut</span> <span class="label">noun</span></dt>
            <dd>The dead time between stopping the recording and starting the real edit: scrubbing through hours of footage to find the parts worth keeping.</dd>
          </dl>
          <p class="hero-lede">
            You know a moment is worth keeping the second it happens. So I built a way to say so right then: press
            <span class="key">F9</span> and keep playing. When you stop recording, Flowmaster cuts those moments out as clips or a reel, and the hours of scrubbing never happen.
          </p>
          <div class="hero-actions">
            <a class="btn-primary hero-cta" href="/account">Create a free account</a>
            <a class="arrow-link" href="/download">Download and trial details</a>
          </div>
          <p class="hero-fine">
            {downloadOpen
              ? <>Free account, 30 actions per PC, no time limit, no payment card. Windows 10 and 11, 64-bit.</>
              : <>The Windows download is not open yet. Create the account now and it is ready when the download opens. Free, with no payment card.</>}
          </p>
        </div>

        <figure class="hero-app">
          <MarkWindow variant="live" />
          <figcaption class="label">The app, rebuilt in HTML. Its tabs jump down the page.</figcaption>
        </figure>
      </div>
    </div>

    <LiveStrip />
  </section>

  <!-- WHERE IT STARTED: a clip from the first pitch -->
  <PitchClip />

  <!-- MARK -->
  <section class="chapter chapter--mark" id="mark" aria-labelledby="mark-title">
    <div class="wrap chapter-grid">
      <div class="chapter-copy" data-reveal>
        <p class="chapter-tag">
          <img src="/brand/RedBox.svg" alt="" width="26" height="25" />
          <span class="chapter-num">01</span>
          <span class="chapter-name">Mark</span>
          <span class="chapter-when">While you record</span>
        </p>
        <h2 id="mark-title" class="display chapter-title">Press F9. Keep playing<span class="stop" aria-hidden="true"></span><span class="sr-only">.</span></h2>
        <p class="chapter-body">
          Flowmaster sits next to OBS Studio and waits for one key. When something happens that you would want in the video, press F9. It saves the timestamp and you carry on. There is nothing to name, nothing to trim and nothing to decide later.
        </p>
        <ul class="chapter-facts">
          <li><strong>F9 is the default.</strong> You can change the mark key in Settings.</li>
          <li><strong>It talks to OBS directly.</strong> Flowmaster connects through OBS&rsquo;s own WebSocket server.</li>
          <li><strong>Every session is listed.</strong> Each recording shows up in the Mark tab with its marks and their timestamps.</li>
        </ul>
      </div>
      <figure class="chapter-app" data-reveal style="--reveal-delay:.12s">
        <MarkWindow variant="log" />
        <figcaption class="label"><span>Mark tab, rebuilt in HTML</span><span>The first session is the one from the hero</span></figcaption>
      </figure>
    </div>
  </section>

  <ChapterClip />
  <ChapterClean />

  <!-- THE ASK -->
  <aside class="band" aria-label="Create an account">
    <div class="wrap band-inner">
      <div>
        <p class="display band-line">
          <span class="band-squares" aria-hidden="true"><span class="sq"></span><span class="sq y"></span><span class="sq g"></span></span>Mark it, clip it, clean it.
        </p>
        <p class="band-sub">That is the whole app. Free account, 30 actions per PC, no time limit, no payment card.</p>
      </div>
      <a class="btn-primary hero-cta" href="/account">Create a free account</a>
    </div>
  </aside>

  <!-- FILM -->
  <section class="film" aria-labelledby="film-title">
    <div class="wrap film-head" data-reveal>
      <p class="label">The film &middot; 90 seconds</p>
      <h2 id="film-title" class="display film-title">Rather watch it?</h2>
    </div>
    <FlowmasterFilm />
  </section>

  <!-- SPEC SHEET -->
  <section class="spec" aria-labelledby="spec-title">
    <div class="wrap">
      <div class="spec-head" data-reveal>
        <div>
          <p class="label">The straight facts</p>
          <h2 id="spec-title" class="display spec-title">What it needs. What it costs.</h2>
        </div>
        <div class="spec-lede">
          <p>The trial is free: 30 actions on one PC, with no time limit, and I do not ask for a payment card.</p>
          <a class="arrow-link" href="/download#trial-rules">Read the exact trial rules</a>
        </div>
      </div>
      <dl class="spec-list" data-reveal style="--reveal-delay:.1s">
        {specs.map(([term, detail]) => (
          <div class="spec-row">
            <dt>{term}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- NOTE -->
  <section class="note" aria-labelledby="note-title">
    <div class="wrap note-grid">
      <div class="note-head" data-reveal>
        <p class="label">Who makes this</p>
        <h2 id="note-title" class="display note-title">It started as a script I wrote for myself.</h2>
      </div>
      <div class="note-body" data-reveal style="--reveal-delay:.1s">
        <p>
          I&rsquo;m Alexander Blair. I make Flowmaster on my own, under the name Alenzie. It exists because I got tired of the rough cut in my own recordings, and I built my way out of it one piece at a time.
        </p>
        <ol class="note-steps">
          <li><span class="label">First</span><p>A small AutoHotkey script that logged a timestamp every time I pressed F9.</p></li>
          <li><span class="label">Then</span><p>A Python auto-cutter that read that log and used FFmpeg to cut out the keepers.</p></li>
          <li><span class="label">Then</span><p>A cleaner script that found recordings with both an original and an edit.</p></li>
          <li><span class="label">Now</span><p>All of it rewritten in Rust as one application. That application is Flowmaster.</p></li>
        </ol>
        <p>
          If something is broken or confusing, tell me. I read
          <a class="text-link" href="mailto:support@flowmastersuite.com">support@flowmastersuite.com</a> and the
          <a class="text-link" href="https://discord.gg/S8uJpcK3qJ" target="_blank" rel="noopener noreferrer">Discord</a>.
        </p>
        <p class="note-sign">Alexander Blair</p>
      </div>
    </div>
  </section>

  <!-- IN DEVELOPMENT -->
  <section class="next" aria-label="In development">
    <div class="wrap next-row" data-reveal>
      <span class="next-tag label">In development</span>
      <p>Events and Flow AI are in development for the December release.</p>
      <a class="arrow-link" href="/future">See what is planned</a>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="closing" aria-labelledby="closing-title">
    <div class="wrap closing-grid" data-reveal>
      <h2 id="closing-title" class="display closing-title"><span>Record everything.</span> Keep only what you meant to keep.</h2>
      <div class="closing-side">
        <div class="closing-actions">
          <a class="btn-primary hero-cta" href="/account">Create a free account</a>
          <a class="arrow-link" href="/download">Download and trial details</a>
        </div>
        <p class="hero-fine">
          {downloadOpen
            ? <>Free account. 30 actions per PC, no time limit, no payment card. Windows 10 and 11, 64-bit.</>
            : <>The Windows download is not open yet. Your free account is ready for it when it opens. No payment card.</>}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nowrap { white-space: nowrap; }

  /* ---------- Hero ---------- */
  .hero { padding-top: calc(var(--nav-h) + clamp(1.4rem, 2vw, 1.75rem)); }
  .hero-eyebrow { display: flex; align-items: center; gap: 0.8rem; }
  .hero-eyebrow img { width: 2.75rem; height: auto; flex: none; }
  .hero-title {
    margin-top: clamp(0.9rem, 1.6vw, 1.2rem);
    font-size: min(17.2vw, 9rem);
    line-height: 0.84;
    font-stretch: 62%;
    font-weight: 800;
  }
  .hero-stop {
    display: inline-block;
    width: 0.2em;
    height: 0.195em;
    margin-left: 0.05em;
    border-radius: 0.02em;
    background: var(--red);
  }
  /* The dictionary entry sits directly under the words it defines. */
  .hero-def {
    display: grid;
    gap: 0.35rem 1.5rem;
    max-width: 40rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--footage);
  }
  .hero-def dt { display: flex; align-items: baseline; gap: 0.75rem; white-space: nowrap; }
  .hero-def-term { font-family: var(--font-heading); font-stretch: 100%; font-weight: 700; font-size: 1.15rem; color: var(--ink); }
  .hero-def dd { margin: 0; font-size: 0.98rem; line-height: 1.5; color: var(--ink-2); }

  .hero-cols { display: grid; gap: 2rem; margin-top: clamp(1.4rem, 2vw, 1.7rem); }
  .hero-lede {
    margin-top: clamp(1.25rem, 1.8vw, 1.45rem);
    max-width: 38rem;
    font-size: clamp(1.1rem, 1.4vw, 1.22rem);
    line-height: 1.5;
    color: var(--ink);
  }
  .hero-actions, .closing-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 1.4rem;
  }
  .hero-cta { min-height: 3.4rem; padding: 0.9rem 1.6rem; font-size: 1.08rem; }
  .hero-fine { margin-top: 0.85rem; max-width: 34rem; font-size: 0.92rem; color: var(--ink-3); }

  .hero-app { position: relative; margin: 0; min-width: 0; }
  .hero-app figcaption { margin-top: 0.8rem; font-size: 0.66rem; }
  /* A little light behind the window, so it sits in front of the page. */
  .hero-app::before {
    content: '';
    position: absolute;
    inset: -14% -3% -6% -12%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(244, 63, 67, 0.1), transparent 72%);
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .hero-title { font-size: min(9.42vw, 8.45rem); }
    .hero-cols { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(2.5rem, 5vw, 4.5rem); align-items: start; }
    .hero-pitch { padding-top: 0.35rem; }
  }
  /* On small screens the strip comes before the app window: the key is the point. */
  @media (max-width: 899px) {
    .hero { display: flex; flex-direction: column; }
    .hero-wrap, .hero-cols { display: contents; }
    .hero-wrap > :not(.hero-cols), .hero-pitch, .hero-app {
      width: calc(100% - 2 * var(--pad));
      margin-inline: var(--pad);
    }
    .hero-pitch { margin-top: 1.5rem; }
    .hero :global(.live) { order: 1; }
    .hero-app { order: 2; margin-top: 2.25rem; max-width: 34rem; }
  }

  /* ---------- The ask ---------- */
  .band { border-block: 1px solid var(--rule-strong); background: #0c0c0c; }
  .band-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 3rem; padding: clamp(1.6rem, 3vw, 2.25rem) 0; }
  .band-line { font-size: clamp(1.9rem, 3.6vw, 2.9rem); line-height: 1; }
  .band-squares { display: inline-flex; gap: 0.12em; margin-right: 0.4em; font-size: 0.78em; }
  .band-sub { margin-top: 0.55rem; font-size: 0.97rem; color: var(--ink-2); }

  /* ---------- Film ---------- */
  .film { padding: clamp(4rem, 8vw, 6.5rem) 0 clamp(2rem, 4vw, 3rem); }
  .film-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.75rem 2rem; margin-bottom: 2rem; }
  .film-title { font-size: clamp(2.5rem, 5vw, 4.25rem); order: -1; }

  /* ---------- Spec sheet ---------- */
  .spec { padding: clamp(3.5rem, 7vw, 5.5rem) 0; border-top: 1px solid var(--rule); }
  .spec-head { display: grid; gap: 1.25rem 4rem; }
  .spec-title { margin-top: 1rem; font-size: clamp(2.5rem, 5vw, 4.25rem); }
  .spec-lede p { max-width: 30rem; font-size: 1.06rem; margin-bottom: 0.6rem; }
  .spec-list { display: grid; gap: 0 2.5rem; margin: clamp(2rem, 4vw, 3rem) 0 0; border-top: 1px solid var(--rule-strong); }
  .spec-row { display: grid; align-content: start; gap: 0.3rem; padding: 1rem 0 1.1rem; border-bottom: 1px solid var(--rule); }
  .spec-row dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .spec-row dd { margin: 0; color: var(--ink); font-size: 0.98rem; line-height: 1.5; }
  @media (min-width: 640px) {
    .spec-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 900px) {
    .spec-head { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); align-items: end; }
    .spec-lede { padding-bottom: 0.3rem; }
  }
  @media (min-width: 1000px) {
    .spec-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* ---------- Note ---------- */
  .note { padding: clamp(4rem, 8vw, 7rem) 0; border-top: 1px solid var(--rule); background: #0c0c0c; }
  .note-grid { display: grid; gap: 2.5rem; }
  .note-title { margin-top: 1rem; font-size: clamp(2.5rem, 5vw, 4.25rem); }
  .note-body { max-width: 38rem; }
  .note-body > p { font-size: 1.1rem; color: var(--ink); line-height: 1.6; }
  .note-steps { list-style: none; margin: 2rem 0; padding: 0; border-top: 1px solid var(--rule); }
  .note-steps li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .note-steps li:last-child .label { color: var(--red); }
  .note-steps p { font-size: 1.02rem; color: var(--ink-2); }
  .note-sign {
    margin-top: 1.75rem;
    font-family: var(--font-heading);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.5rem !important;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  @media (min-width: 900px) {
    .note-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: clamp(3rem, 7vw, 7rem); }
  }

  /* ---------- In development ---------- */
  .next { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .next-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; padding: 1.4rem 0; }
  .next-tag { padding: 0.3rem 0.6rem; border: 1px solid var(--rule-strong); border-radius: 4px; color: var(--ink-2); }
  .next-row p { flex: 1 1 20rem; color: var(--ink); }

  /* ---------- Closing ---------- */
  .closing { padding: clamp(4rem, 8vw, 6.5rem) 0; }
  .closing-grid { display: grid; gap: 2rem; }
  .closing-title { font-size: clamp(2.7rem, 6vw, 5.4rem); line-height: 0.88; font-stretch: 62%; }
  .closing-title span { display: block; color: var(--ink-3); }
  .closing-actions { margin-top: 0; }
  @media (min-width: 1000px) {
    .closing-grid { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 4rem; align-items: end; }
    .closing-side { padding-bottom: 0.4rem; }
  }
</style>
