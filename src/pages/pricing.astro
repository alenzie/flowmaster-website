---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Free trial" description="Flowmaster is preparing a free 30-action trial for Windows. Paid trials and purchases are unavailable.">
  <section class="section-padding"><div class="container-main max-w-2xl mx-auto text-center">
    <h1 class="mb-6">Try the workflow. No payment card.</h1>
    <p class="text-lg mb-6">Flowmaster’s trial includes 30 actions per PC. It requires an internet connection to verify usage, and a free account, with no time limit.</p>
    <p class="mb-8">Accounts are free. Paid trials and upgrades are currently unavailable. See the download page for the release status and exact trial rules.</p>
    <a class="btn-primary" href="/download">Free trial details</a>
  </div></section>
</BaseLayout>
