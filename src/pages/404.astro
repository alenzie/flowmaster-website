---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/notice.css';
---

<BaseLayout title="Page Not Found">
  <!-- Invite-specific 404 (hidden by default, shown via JS if path matches) -->
  <section id="invite-404" class="nf" style="display: none;">
    <div class="wrap nf-grid nf-grid--solo">
      <div class="nf-copy">
        <p class="label">Invite link</p>
        <h1 class="display nf-title nf-title--long">Whoops, that invite link <span>didn&rsquo;t seem to work<i class="nf-stop" aria-hidden="true"></i></span></h1>
        <p class="nf-lede">
          The link may have been typed incorrectly, or you might need to ask for a new one.
        </p>
        <div class="nf-actions">
          <a id="try-invite-btn" href="/invite/" class="btn-primary">Try again</a>
          <a href="/" class="arrow-link">Visit Flowmaster</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Generic 404 -->
  <section id="generic-404" class="nf">
    <div class="wrap nf-grid">
      <div class="nf-copy">
        <p class="label">Error 404</p>
        <h1 class="display nf-title">Page not found<i class="nf-stop" aria-hidden="true"></i></h1>
        <p class="nf-lede">
          The page you&rsquo;re looking for doesn&rsquo;t exist or has been moved.
        </p>
        <div class="nf-actions">
          <a href="/" class="btn-primary">Back to home</a>
        </div>
      </div>
      <p class="nf-side nf-num" aria-hidden="true">404</p>
    </div>
  </section>

  <script is:inline>
    (function() {
      var path = window.location.pathname;
      if (path.startsWith('/invite/')) {
        var code = path.replace('/invite/', '').replace(/\/$/, '');
        // Show invite 404, hide generic 404
        document.getElementById('invite-404').style.display = 'block';
        document.getElementById('generic-404').style.display = 'none';
        // Wire up "Try Again" to pass the code as a query param
        if (code) {
          document.getElementById('try-invite-btn').href = '/invite/?code=' + encodeURIComponent(code);
        }
      }
    })();
  </script>
</BaseLayout>
