---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocsNav from '../../components/docs/DocsNav.astro';
import '../../styles/docs.css';
---

<BaseLayout title="Documentation">
  <div class="docs">
    <div class="wrap docs-grid">
      <aside class="docs-side">
        <DocsNav current="/docs" />
      </aside>

      <article class="docs-main">
        <header>
          <p class="label docs-crumb">Docs<span aria-hidden="true">/</span>Getting started</p>
          <h1 class="display docs-title">Getting started<span class="docs-stop" aria-hidden="true"></span></h1>
          <p class="docs-lede">Get Flowmaster running in 5 minutes</p>
        </header>

        <section class="docs-section" aria-labelledby="quick-start">
          <h2 id="quick-start" class="docs-sub-head">Quick start</h2>
          <ol class="docs-steps">
            <li>
              <div>
                <h3>Download and install Flowmaster</h3>
                <p>Get the installer from the <a href="/download" class="text-link">download page</a>.</p>
              </div>
            </li>
            <li>
              <div>
                <h3>Set up OBS integration</h3>
                <p>Follow the <a href="/docs/obs-setup" class="text-link">OBS setup guide</a> to connect Flowmaster with OBS.</p>
              </div>
            </li>
            <li>
              <div>
                <h3>Configure your output folder</h3>
                <p>Tell Flowmaster where your OBS recordings are saved.</p>
              </div>
            </li>
            <li>
              <div>
                <h3>Start recording and press F9</h3>
                <p>Hit <span class="key">F9</span> whenever something highlight-worthy happens.</p>
              </div>
            </li>
            <li>
              <div>
                <h3>Run Clip</h3>
                <p>Process your footage with one click.</p>
              </div>
            </li>
            <li>
              <div>
                <h3>Run Clean</h3>
                <p>Free up space by removing processed originals.</p>
              </div>
            </li>
          </ol>

          <div class="docs-more">
            <p>Need more help?</p>
            <a href="https://www.flowmaster.live/docs/" target="_blank" rel="noopener noreferrer" class="arrow-link">View full documentation</a>
          </div>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>
