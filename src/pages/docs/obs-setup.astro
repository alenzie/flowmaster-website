---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocsNav from '../../components/docs/DocsNav.astro';
import '../../styles/docs.css';

// Screenshots still to be captured. The old page showed an empty "Screenshot
// needed" box for each; they are listed here until the real images exist.
//   Step 1, after 1.2: OBS menu, Tools > WebSocket Server Settings
//   Step 1, after 1.6: OBS WebSocket Server Settings panel with "Enable" checked
//   Step 2, after 2.2: Flowmaster header, settings gear highlighted
//   Step 2, after 2.5: Flowmaster Settings, OBS Connection section with Port and Password fields
//   Step 3, after 3.2: Flowmaster Settings, "Test Connection" button highlighted
//   Step 3, end:       Flowmaster showing green connection status and the "Connected to OBS" message
//   Step 4, after 4.2: Flowmaster Mark tab showing "Recording" status (not "Idle")
//   Step 4, end:       Flowmaster showing the timestamps list with several marks

const steps = [
  {
    title: 'Enable WebSocket server in OBS',
    intro: 'OBS has a built-in WebSocket server that Flowmaster uses to detect when you start and stop recording.',
    items: [
      'Open OBS Studio',
      'Go to <strong>Tools</strong> &rarr; <strong>WebSocket Server Settings</strong>',
      'Check <strong>&ldquo;Enable WebSocket server&rdquo;</strong>',
      'Note the <strong>Server Port</strong> (default is 4455)',
      'If you want a password, check &ldquo;Enable Authentication&rdquo; and set one (optional)',
      'Click <strong>Apply</strong> or <strong>OK</strong>',
    ],
  },
  {
    title: 'Configure Flowmaster',
    intro: 'Tell Flowmaster how to connect to your OBS WebSocket server.',
    items: [
      'Open <strong>Flowmaster</strong>',
      'Click the <strong>Settings gear</strong> in the top right',
      'Scroll to the <strong>OBS Connection</strong> section',
      'Enter the <strong>Port</strong> (same as OBS, default 4455)',
      'If you set a password in OBS, enter it here. Otherwise leave blank.',
    ],
  },
  {
    title: 'Test the connection',
    intro: 'Verify that Flowmaster can talk to OBS.',
    items: [
      'Make sure <strong>OBS is running</strong>',
      'In Flowmaster Settings, click <strong>Test Connection</strong>',
    ],
    expect: true,
  },
  {
    title: 'Start recording and mark highlights',
    intro: 'Once connected, Flowmaster automatically detects when you start and stop recording.',
    items: [
      'Click <strong>Start Recording</strong> in OBS (or use your hotkey)',
      'Flowmaster will automatically switch from &ldquo;Idle&rdquo; to <strong>&ldquo;Recording&rdquo;</strong>',
      'Press your hotkey (default <span class="key">F9</span>) to mark highlights during gameplay',
      'Stop recording in OBS - Flowmaster will save your timestamps automatically',
    ],
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title="OBS Setup">
  <div class="docs">
    <div class="wrap docs-grid">
      <aside class="docs-side">
        <DocsNav current="/docs/obs-setup" />
      </aside>

      <article class="docs-main">
        <header>
          <p class="label docs-crumb"><a href="/docs">Docs</a><span aria-hidden="true">/</span>OBS setup</p>
          <h1 class="display docs-title">OBS setup guide<span class="docs-stop" aria-hidden="true"></span></h1>
          <p class="docs-lede">Connect Flowmaster to OBS via WebSocket</p>

          <dl class="docs-ref" aria-label="Quick reference">
            <div><dt>Default port</dt><dd class="docs-mono">4455</dd></div>
            <div><dt>Password</dt><dd>Optional</dd></div>
            <div><dt>Plugins</dt><dd>None required</dd></div>
          </dl>
        </header>

        <div class="docs-notes">
          <section aria-labelledby="no-plugins">
            <h2 id="no-plugins" class="docs-sub-head">No plugins required</h2>
            <p>Flowmaster connects directly to OBS using the built-in WebSocket server. No need for Advanced Scene Switcher or external executables.</p>
          </section>

          <section aria-labelledby="status-light">
            <h2 id="status-light" class="docs-sub-head">Understanding the connection status light</h2>
            <p>The colored dot in Flowmaster&rsquo;s header shows your OBS connection status:</p>
            <ul class="docs-lights">
              <li><span class="docs-light docs-light--g" aria-hidden="true"></span><span><strong>Green</strong> - Connected to OBS</span></li>
              <li><span class="docs-light docs-light--r" aria-hidden="true"></span><span><strong>Red</strong> - Not connected</span></li>
              <li><span class="docs-light docs-light--y" aria-hidden="true"></span><span><strong>Yellow</strong> - Connecting...</span></li>
            </ul>
          </section>
        </div>

        {steps.map((step, i) => (
          <section class="docs-step" id={`step-${i + 1}`} aria-labelledby={`step-${i + 1}-title`}>
            <div class="docs-step-head">
              <span class="docs-step-num">Step {pad(i + 1)}</span>
              <h2 id={`step-${i + 1}-title`} class="display docs-h2">{step.title}</h2>
              <p>{step.intro}</p>
            </div>
            <div>
              <ol class="docs-sub">
                {step.items.map((item, j) => (
                  <li><span class="docs-sub-num" aria-hidden="true">{i + 1}.{j + 1}</span><span set:html={item} /></li>
                ))}
              </ol>

              {step.expect && (
                <div class="docs-expect">
                  <h3 class="docs-sub-head">What to expect</h3>
                  <ul class="docs-lights">
                    <li><span class="docs-light docs-light--g" aria-hidden="true"></span><span><strong>Success:</strong> The status light turns green, and you&rsquo;ll see &ldquo;Connected to OBS&rdquo;</span></li>
                    <li><span class="docs-light docs-light--r" aria-hidden="true"></span><span><strong>Failed:</strong> Check that OBS is open and the port/password match</span></li>
                  </ul>
                </div>
              )}
            </div>
          </section>
        ))}

        <section class="docs-step" id="troubleshooting" aria-labelledby="troubleshooting-title">
          <div class="docs-step-head">
            <span class="docs-step-num">Help</span>
            <h2 id="troubleshooting-title" class="display docs-h2">Troubleshooting</h2>
          </div>
          <div>
            <div class="docs-faq">
              <details>
                <summary>Connection stays red even though OBS is open</summary>
                <div class="docs-faq-body">
                  <p>Check these common issues:</p>
                  <ul>
                    <li>Make sure WebSocket Server is <strong>enabled</strong> in OBS (Tools &rarr; WebSocket Server Settings)</li>
                    <li>Verify the port numbers match (default is 4455)</li>
                    <li>If you set a password in OBS, make sure it&rsquo;s entered in Flowmaster</li>
                    <li>Try restarting both OBS and Flowmaster</li>
                    <li>Check if a firewall is blocking the connection</li>
                  </ul>
                </div>
              </details>

              <details>
                <summary>Flowmaster doesn&rsquo;t detect when I start recording</summary>
                <div class="docs-faq-body">
                  <p>If the connection light is green but recording isn&rsquo;t detected:</p>
                  <ul>
                    <li>Make sure you&rsquo;re clicking &ldquo;Start Recording&rdquo; (not &ldquo;Start Streaming&rdquo;)</li>
                    <li>Try the <strong>Simulate Live</strong> button in Flowmaster to test without OBS</li>
                    <li>Check the Flowmaster logs for any error messages</li>
                  </ul>
                </div>
              </details>

              <details>
                <summary>I was using Advanced Scene Switcher before - do I still need it?</summary>
                <div class="docs-faq-body">
                  <p><strong>No!</strong> Flowmaster now connects directly to OBS via WebSocket.</p>
                  <p>You can safely:</p>
                  <ul>
                    <li>Remove the start/stop macros from Advanced Scene Switcher</li>
                    <li>Delete <code>flowmaster-start.exe</code> and <code>flowmaster-stop.exe</code> if you have them</li>
                    <li>Keep Advanced Scene Switcher if you use it for other things, but it&rsquo;s not needed for Flowmaster</li>
                  </ul>
                </div>
              </details>

              <details>
                <summary>What port should I use?</summary>
                <div class="docs-faq-body">
                  <p>The default port <code>4455</code> works for most people.</p>
                  <p>Only change it if:</p>
                  <ul>
                    <li>Another application is already using port 4455</li>
                    <li>You changed it in OBS for a specific reason</li>
                  </ul>
                  <p>If you change the port in OBS, make sure to update it in Flowmaster too.</p>
                </div>
              </details>
            </div>

            <p class="docs-after">
              Still having issues? Check our <span class="docs-soon-inline">full troubleshooting guide (coming soon)</span>
              or <a href="https://discord.gg/flowmaster" target="_blank" rel="noopener noreferrer" class="text-link">join our Discord</a> for help.
            </p>
          </div>
        </section>

        <section class="docs-step docs-done" aria-labelledby="done-title">
          <div class="docs-step-head">
            <span class="docs-step-num">Done</span>
            <h2 id="done-title" class="display docs-h2">You&rsquo;re all set<span class="docs-stop docs-stop--g" aria-hidden="true"></span></h2>
          </div>
          <div class="docs-done-body">
            <p>
              Flowmaster will now automatically detect your OBS recordings.
              Just start recording, press your hotkey to mark highlights, and stop recording -
              Flowmaster handles the rest.
            </p>
            <a href="/docs" class="docs-back">Back to documentation</a>
          </div>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>
