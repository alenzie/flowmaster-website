---
import BaseLayout from '../layouts/BaseLayout.astro';
import service from '../data/supabase.json';
---
<BaseLayout title="Your Flowmaster account" description="Sign in or create a free Flowmaster account with Google or email. Paid upgrades are unavailable.">
  <section class="account-shell">
    <div class="account-intro"><h1>One account.<br />Every Moment.</h1><p>Create a free account to use Flowmaster. Each PC has a 30-action trial. Creating another account or reinstalling keeps that PC’s existing usage.</p><p>Paid trials and upgrades are unavailable.</p></div>
    <div class="account-card">
      <h2 id="account-title">Sign in</h2>
      {!service.emailReady && <p class="account-service-status" role="status">Free account signup and password-reset emails are being connected. These options will open when email delivery is verified. Existing accounts can still sign in.</p>}
      <p id="account-message" role="status" aria-live="polite"></p>
      <div id="account-google-options">
        <button id="account-google" type="button" disabled aria-describedby="account-google-status">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5Z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65Z"/><path fill="#FBBC05" d="M10.53 28.59A14.4 14.4 0 0 1 9.75 24c0-1.59.27-3.13.78-4.59l-7.98-6.19A23.9 23.9 0 0 0 0 24c0 3.87.93 7.53 2.56 10.78l7.97-6.19Z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.91-5.8l-7.73-6c-2.15 1.45-4.92 2.3-8.18 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48Z"/></svg>
          <span>Continue with Google</span>
        </button>
        <p id="account-google-status" role="status">Checking Google sign-in…</p>
        <div class="account-divider"><span>or use email</span></div>
      </div>
      <form id="account-form">
        <label for="account-email">Email</label><input id="account-email" type="email" autocomplete="email" required />
        <label for="account-password">Password</label><input id="account-password" type="password" autocomplete="current-password" required minlength="8" />
        <button id="account-submit" type="submit">Sign in</button>
      </form>
      <div id="account-options"><button id="account-switch" type="button" disabled={!service.emailReady}>Create a free account</button><button id="account-recover" type="button" disabled={!service.emailReady}>Forgot your password?</button></div>
      <form id="password-form" hidden>
        <label for="new-password">New password</label><input id="new-password" type="password" autocomplete="new-password" required minlength="8" />
        <label for="confirm-password">Confirm password</label><input id="confirm-password" type="password" autocomplete="new-password" required minlength="8" />
        <button type="submit">Save password</button>
        <button id="password-cancel" type="button" hidden>Back to your account</button>
      </form>
      <div id="account-signed-in" hidden><p id="account-ready">Your account is ready. Open Flowmaster and sign in with the same email and password.</p><button id="account-set-password" type="button" hidden>Set a Flowmaster password</button><a href="/download">Download and trial details →</a>
        <section id="release-preferences" class="release-preferences" aria-labelledby="release-preferences-title" hidden>
          <h3 id="release-preferences-title">Release emails</h3>
          <p>Occasional news when Flowmaster has something new. This is optional and separate from account and security emails.</p>
          <form id="release-preferences-form">
            <label class="release-preferences-choice" for="release-email-enabled"><input id="release-email-enabled" type="checkbox" disabled /><span id="release-consent-text">Email me Flowmaster release announcements and product updates. I can unsubscribe at any time.</span></label>
            <button id="release-preferences-save" type="submit" disabled>Save email preference</button>
          </form>
          <button id="release-preferences-unsubscribe" type="button">Unsubscribe from release emails</button>
          <button id="release-preferences-retry" type="button" hidden>Try loading preferences again</button>
          <p id="release-preferences-message" role="status" aria-live="polite"></p>
        </section>
        <button id="account-signout" type="button">Sign out of this browser</button></div>
      <p class="account-note">An internet connection is required to sign in and verify trial usage. <a href="/privacy">How we use your data</a> · <a href="/terms">Terms of Service</a></p>
    </div>
  </section>
</BaseLayout>
<script>
  import { createClient, type Session } from '@supabase/supabase-js';
  import config from '../data/supabase.json';
  let recovery = new URLSearchParams(location.hash.slice(1)).get('type') === 'recovery';
  const db = createClient(config.url, config.publishableKey, { auth: { storage: sessionStorage } });
  const $ = (id: string) => document.getElementById(id)!;
  const input = (id: string) => $(id) as HTMLInputElement;
  const message = (text: string) => { $('account-message').textContent = text; };
  let signup = false;
  let settingPassword = false;
  let activeSession: Session | null = null;
  let preferenceEpoch = 0;
  let preferenceSessionKey = '';
  let consentVersion = '';
  let preferenceLoaded = false;
  let preferenceBlocked = false;
  const preferenceMessage = (text: string) => { $('release-preferences-message').textContent = text; };
  const preferenceButton = (id: string) => $(id) as HTMLButtonElement;
  function preferenceControls(busy = false) {
    input('release-email-enabled').disabled = busy || !preferenceLoaded || preferenceBlocked;
    preferenceButton('release-preferences-save').disabled = busy || !preferenceLoaded || preferenceBlocked;
    preferenceButton('release-preferences-unsubscribe').disabled = busy;
  }
  async function preferenceRequest(session: Session, payload: Record<string, unknown>) {
    const response = await fetch(`${config.url}/functions/v1/account-email-preferences`, {
      method: 'POST', headers: { apikey: config.publishableKey, Authorization: `Bearer ${session.access_token}`, 'Content-Type': 'application/json' },
      body: JSON.stringify(payload), signal: AbortSignal.timeout(12000),
    });
    if (!response.ok) throw new Error(response.status === 401 ? 'Your sign-in has expired. Sign in again to manage release emails.' : 'Your email preference could not be confirmed. Please try again.');
    const result = await response.json();
    if (typeof result.enabled !== 'boolean' || typeof result.blocked !== 'boolean' || result.consentVersion !== 'release-updates-v1' || typeof result.consentText !== 'string') throw new Error('Your email preference could not be confirmed. Please try again.');
    return result as { enabled: boolean; blocked: boolean; consentVersion: string; consentText: string };
  }
  function applyPreference(result: { enabled: boolean; blocked: boolean; consentVersion: string; consentText: string }) {
    preferenceLoaded = true; preferenceBlocked = result.blocked; consentVersion = result.consentVersion;
    input('release-email-enabled').checked = result.enabled;
    $('release-consent-text').textContent = result.consentText;
    $('release-preferences-retry').hidden = true;
  }
  async function loadPreference(session: Session) {
    const epoch = ++preferenceEpoch;
    preferenceLoaded = false; preferenceBlocked = false; consentVersion = '';
    input('release-email-enabled').checked = false; preferenceControls();
    preferenceMessage('Loading your email preference…'); $('release-preferences-retry').hidden = true;
    try {
      const result = await preferenceRequest(session, { operation: 'get' });
      if (epoch !== preferenceEpoch || activeSession?.access_token !== session.access_token) return;
      applyPreference(result);
      preferenceMessage(result.blocked ? 'Release emails are paused because of a delivery issue. Contact support@flowmastersuite.com if you want to receive them again.' : result.enabled ? 'You’re subscribed to release emails.' : 'You’re not subscribed to release emails.');
    } catch (error) {
      if (epoch !== preferenceEpoch || activeSession?.access_token !== session.access_token) return;
      preferenceMessage(error instanceof Error ? error.message : 'Could not load your preference. Please try again.');
      $('release-preferences-retry').hidden = false;
    } finally { if (epoch === preferenceEpoch) preferenceControls(); }
  }
  function syncPreference(session: Session | null) {
    const verified = !!session?.user.email_confirmed_at;
    $('release-preferences').hidden = !verified;
    const key = verified ? session!.access_token : '';
    if (key === preferenceSessionKey) return;
    preferenceSessionKey = key; ++preferenceEpoch;
    preferenceLoaded = false; consentVersion = ''; input('release-email-enabled').checked = false; preferenceMessage('');
    if (verified) void loadPreference(session!);
  }
  async function savePreference(enabled: boolean) {
    const session = activeSession;
    if (!session?.user.email_confirmed_at || (enabled && (!preferenceLoaded || preferenceBlocked))) return;
    const epoch = ++preferenceEpoch; preferenceControls(true); preferenceMessage('Saving your email preference…');
    try {
      const result = await preferenceRequest(session, { operation: 'set', enabled, consentVersion: enabled ? consentVersion : 'release-updates-v1' });
      if (epoch !== preferenceEpoch || activeSession?.access_token !== session.access_token) return;
      applyPreference(result);
      preferenceMessage(result.enabled ? 'You’re subscribed to release emails. You can unsubscribe here at any time.' : 'You’re unsubscribed from release emails. Account and security emails are unaffected.');
    } catch (error) {
      if (epoch !== preferenceEpoch || activeSession?.access_token !== session.access_token) return;
      // A timeout may follow a committed change. Do not show the desired checkbox
      // value as confirmed; require a fresh read before another opt-in attempt.
      preferenceLoaded = false; input('release-email-enabled').checked = false;
      preferenceMessage(error instanceof Error ? error.message : 'Your email preference could not be confirmed. Please try again.');
      $('release-preferences-retry').hidden = false;
    } finally { if (epoch === preferenceEpoch) preferenceControls(); }
  }
  $('release-preferences-form').addEventListener('submit', event => { event.preventDefault(); void savePreference(input('release-email-enabled').checked); });
  $('release-preferences-unsubscribe').addEventListener('click', () => { void savePreference(false); });
  $('release-preferences-retry').addEventListener('click', () => { if (activeSession) void loadPreference(activeSession); });
  const callbackError = new URLSearchParams(location.hash.slice(1)).get('error');
  if (callbackError) {
    message(callbackError === 'access_denied' ? 'Google sign-in wasn’t completed. Try again or use email below.' : 'Sign-in could not be completed. Please try again.');
    history.replaceState(null, '', location.pathname + location.search);
  }
  function showSession(session: Session | null, reset = false) {
    activeSession = session;
    syncPreference(session);
    const signedIn = !!session;
    if (!signedIn) settingPassword = false;
    const passwordScreen = reset || (signedIn && settingPassword);
    // This only chooses guidance; account permissions remain server-side.
    const googleAccount = session?.user.identities?.some(identity => identity.provider === 'google');
    $('account-form').hidden = signedIn;
    $('account-options').hidden = signedIn;
    $('account-google-options').hidden = signedIn;
    $('password-form').hidden = !passwordScreen;
    $('password-cancel').hidden = !settingPassword;
    $('account-signed-in').hidden = !signedIn || passwordScreen;
    $('account-set-password').hidden = !googleAccount;
    $('account-ready').textContent = googleAccount
      ? 'You’re signed in with Google. The desktop app and admin panel currently use a Flowmaster password. Set one here for this same account, or use your existing Flowmaster password. Never enter your Google password into Flowmaster.'
      : 'Your account is ready. Open Flowmaster and sign in with the same email and password.';
    $('account-title').textContent = passwordScreen ? 'Set a Flowmaster password' : signedIn ? 'You’re signed in' : signup ? 'Create a free account' : 'Sign in';
  }
  db.auth.onAuthStateChange((event, session) => { showSession(session, !!session && (event === 'PASSWORD_RECOVERY' || recovery)); });
  db.auth.getSession().then(({ data, error }) => { if (error) message('Sign-in could not be completed. Please try again.'); else showSession(data.session, !!data.session && recovery); });
  async function googleAvailable() {
    const response = await fetch(`${config.url}/auth/v1/settings`, { headers: { apikey: config.publishableKey }, signal: AbortSignal.timeout(8000) });
    if (!response.ok) throw new Error('Settings unavailable');
    return (await response.json()).external?.google === true;
  }
  async function checkGoogle() {
    try {
      const enabled = await googleAvailable();
      ($('account-google') as HTMLButtonElement).disabled = !enabled;
      $('account-google-status').textContent = enabled ? 'For new and existing accounts.' : 'Google sign-in is being connected. You can use email below for now.';
    } catch {
      $('account-google-status').textContent = 'Google sign-in is unavailable right now. Refresh to retry, or use email below.';
    }
  }
  void checkGoogle();
  $('account-google').addEventListener('click', async () => {
    const button = $('account-google') as HTMLButtonElement;
    button.disabled = true; message('Opening Google…');
    try {
      if (!await googleAvailable()) throw new Error('Google unavailable');
      const { error } = await db.auth.signInWithOAuth({ provider: 'google', options: { redirectTo: 'https://flowmaster.live/account', queryParams: { prompt: 'select_account' } } });
      if (error) throw error;
    } catch {
      message('Google sign-in could not start. Please try again or use email below.');
      await checkGoogle();
    }
  });
  window.addEventListener('pageshow', event => { if (event.persisted) { message(''); void checkGoogle(); } });
  $('account-set-password').addEventListener('click', () => { settingPassword = true; message('Choose a separate password for Flowmaster. Your Google sign-in will still work.'); showSession(activeSession); input('new-password').focus(); });
  $('password-cancel').addEventListener('click', () => { settingPassword = false; input('new-password').value = ''; input('confirm-password').value = ''; message(''); showSession(activeSession); });
  $('account-switch').addEventListener('click', () => {
    signup = !signup;
    $('account-title').textContent = signup ? 'Create a free account' : 'Sign in';
    $('account-submit').textContent = signup ? 'Create account' : 'Sign in';
    $('account-switch').textContent = signup ? 'Already have an account? Sign in' : 'Create a free account';
    input('account-password').autocomplete = signup ? 'new-password' : 'current-password';
    message('');
  });
  $('account-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = $('account-submit') as HTMLButtonElement; button.disabled = true; message('');
    try {
      const credentials = { email: input('account-email').value.trim(), password: input('account-password').value };
      const { error } = signup ? await db.auth.signUp({ ...credentials, options: { emailRedirectTo: 'https://flowmaster.live/account' } }) : await db.auth.signInWithPassword(credentials);
      if (error) throw error;
      input('account-password').value = '';
      if (signup) message('Check your email to confirm your account, then sign in to Flowmaster.');
    } catch (error) { message(error instanceof Error ? error.message : 'Could not complete your request. Please retry.'); }
    finally { button.disabled = false; }
  });
  $('account-recover').addEventListener('click', async () => {
    const email = input('account-email').value.trim();
    if (!email || !input('account-email').checkValidity()) { message('Enter your email address first.'); return; }
    const button = $('account-recover') as HTMLButtonElement; button.disabled = true;
    try {
      const { error } = await db.auth.resetPasswordForEmail(email, { redirectTo: 'https://flowmaster.live/account' });
      message(error ? error.message : 'If this account exists, you’ll receive a password-reset email.');
    } catch { message('Could not send the reset email. Check your connection and retry.'); }
    finally { button.disabled = false; }
  });
  $('password-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    if (input('new-password').value !== input('confirm-password').value) { message('Passwords do not match.'); return; }
    const button = $('password-form').querySelector('button')!; button.disabled = true;
    try {
      const { error } = await db.auth.updateUser({ password: input('new-password').value });
      if (error) throw error;
      input('new-password').value = ''; input('confirm-password').value = '';
      recovery = false; settingPassword = false;
      const { error: signoutError } = await db.auth.signOut();
      if (signoutError) { showSession(activeSession); message('Password saved. You’re still signed in to this browser.'); }
      else { showSession(null); message('Password saved. Sign in to Flowmaster with your email and this password.'); }
    } catch (error) { message(error instanceof Error ? error.message : 'Could not change your password.'); }
    finally { button.disabled = false; }
  });
  $('account-signout').addEventListener('click', async () => { const { error } = await db.auth.signOut(); if (error) message(error.message); else { recovery = false; message(''); showSession(null); } });
</script>
<style>
.release-preferences{margin-top:30px;padding-top:24px;border-top:1px solid #34393f}.release-preferences h3{font-size:18px;font-weight:650;margin:0 0 10px}.release-preferences p{color:#b3b7bf;font-size:13px;line-height:1.6}.account-card label.release-preferences-choice{display:flex;align-items:flex-start;gap:12px;font-size:14px;line-height:1.6;margin-top:18px}.account-card #release-email-enabled{width:18px;height:18px;flex:0 0 18px;margin-top:3px;padding:0;accent-color:#a6ffba}.account-card #release-preferences-save{margin-top:16px;font-size:14px}.account-card #release-preferences-unsubscribe,.account-card #release-preferences-retry{font-size:13px;text-decoration:underline;line-height:1.5}#release-preferences-message{margin-top:16px}

.account-card #account-google{display:flex;align-items:center;justify-content:center;gap:12px;width:100%;min-height:44px;margin:16px 0 0;padding:12px 18px;background:#f2f2f2;color:#1f1f1f;border:1px solid #747775;border-radius:6px;font-family:Arial,sans-serif;font-size:14px;font-weight:500;text-align:center}.account-card #account-google:not(:disabled):hover{background:#e5e5e5}.account-card #account-google svg{flex-shrink:0}#account-google-status{font-size:12px;color:#b3b7bf;line-height:1.5;margin-top:10px}.account-divider{display:flex;align-items:center;gap:12px;margin:22px 0;color:#979fa9;font-size:12px}.account-divider::before,.account-divider::after{content:'';height:1px;flex:1;background:#34393f}#account-ready{line-height:1.65;color:#cbd0d9}#account-signed-in>a{display:block;margin-top:20px}
.account-shell{max-width:1100px;margin:auto;padding:100px 24px;display:grid;grid-template-columns:1.1fr 1fr;gap:72px;align-items:start}.eyebrow{font-size:12px;letter-spacing:.18em;color:#a6ffba;margin-bottom:24px}.account-intro h1{font-size:clamp(38px,5vw,64px);line-height:1.06;margin-bottom:30px}.account-intro p:not(.eyebrow){color:#b3b7bf;line-height:1.7;margin-top:20px}.account-card{background:#15181b;border:1px solid #34393f;border-radius:16px;padding:30px}.account-card h2{font-size:25px;margin-bottom:18px}.account-card label{display:block;font-size:13px;margin:18px 0 7px}.account-card input{width:100%;background:#0b0d10;border:1px solid #42484f;border-radius:6px;padding:12px;color:white}.account-card button[type=submit]{display:block;width:100%;background:#a6ffba;color:#0a1710;padding:12px;margin-top:24px;border-radius:6px;font-weight:650}.account-card button:disabled{opacity:.5;cursor:not-allowed}.account-service-status{padding:14px;background:#252516;border:1px solid #62603c;border-radius:6px;color:#e3dfb3;font-size:14px;line-height:1.5;margin-bottom:20px}.account-card button[type=button]{display:block;color:#a6ffba;text-align:left;margin-top:17px}.account-card a{color:#a6ffba}.account-card [hidden]{display:none!important}#account-message{color:#cbd0d9;font-size:14px;line-height:1.5}.account-note{font-size:12px;line-height:1.6;color:#979fa9;margin-top:30px}.account-card input:focus-visible,.account-card button:focus-visible{outline:2px solid #a6ffba;outline-offset:3px}@media(max-width:760px){.account-shell{grid-template-columns:1fr;gap:36px;padding:60px 20px}.account-card{padding:24px}}
</style>
