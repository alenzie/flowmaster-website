---
import BaseLayout from '../layouts/BaseLayout.astro';
import landscapeMock from '../assets/app/MobileAppMockLandscape_Large.png';
import portraitMock from '../assets/app/MobileAppMockVertical.png';

// Owner 2026-11-23: the phased roadmap section is removed; the page leads with Events and Flow AI.
const spotlight = [
  {
    id: 'events',
    name: 'Events',
    caption: 'Events tab preview',
    image: '/images/roadmap/events-preview.jpg',
    alt: 'The Events tab: a scanned recording with its events on a timeline and a list of detected moments with Jump buttons',
    lead: 'Flowmaster scans the pixels on your screen, and finds the moments for you.',
    points: [
      'Runs after you record, on your PC. The scan itself uses no AI.',
      'Reads HUD cues like hit markers and the kill feed, plus game sounds.',
      'Finds kills, deaths, assists, objectives and round wins, next to your own F9 marks.',
      'A timeline and event list for each recording, and one sortable table across all of them.',
      'Per-game detection templates you can import and share.',
      'Unsure detections wait for your review and are never used on their own.',
    ],
  },
  {
    id: 'flow-ai',
    name: 'Flow AI',
    caption: 'Flow AI tab preview',
    image: '/images/roadmap/flow-preview.jpg',
    alt: 'The Flow AI tab: asked what video to make this week, Flow suggests a streak montage and shows a plan waiting for approval',
    lead: 'Your AI editing buddy. Ask it what to make from this week’s footage.',
    points: [
      'Reads your marks and events: session recaps, clip pools, review reels.',
      'Asks what you’re making first: a let’s play, a highlight collage, a beat-synced montage, or your own.',
      'Builds montages in Beat mode and hands plans to your editor as a new project.',
      'Every action is a preview card you approve with one click.',
      'Receipts on every answer: what it looked up, with links that jump to the moment.',
      'Its memory is a notes file you can read, edit and wipe.',
    ],
  },
];

const comparisons = [
  {
    versus: 'vs. OBS',
    title: 'More than recording',
    description: 'OBS captures footage. Flowmaster captures footage AND helps you edit it. Mark moments live, cut automatically, clean up files - all in one workflow.',
  },
  {
    versus: 'vs. AI editors',
    title: 'You stay in control',
    description: 'AI editors guess what’s important and cut it for you. Flow suggests from your own marks and events, shows its receipts, and waits for your yes. No black box. No surprises.',
  },
  {
    versus: 'vs. Riverside',
    title: 'Podcasting, free forever',
    description: 'Remote guest recording with local quality - and it won’t cost you $24/month. Podcasting mode is free. Always.',
  },
];

const appBenefits = [
  {
    title: 'Mark without interrupting',
    description: 'Tap to mark highlight moments without taking your hands off the controller. Your phone becomes a dedicated F9 button.',
  },
  {
    title: 'Real-time session view',
    description: 'See your recording timeline, elapsed time, and recent markers update live as you play.',
  },
  {
    title: 'Stay in control',
    description: 'Monitor connection status, storage space, and session state at a glance. No surprises when you’re done recording.',
  },
  {
    title: 'Works your way',
    description: 'Landscape for full timeline access, portrait for quick one-handed marking. Adapts to how you play.',
  },
];

const num = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout title="Future">
  <!-- TOP -->
  <section class="ft-top">
    <div class="wrap ft-top-grid">
      <div class="ft-intro">
        <p class="label">Roadmap</p>
        <h1 class="display ft-title">The future <span>of Flowmaster<i class="ft-stop" aria-hidden="true"></i></span></h1>
        <p class="ft-lede">Events and Flow AI are in development for the December release. Here’s what they do, and what comes after.</p>
      </div>

      <nav class="ft-index" aria-label="On this page">
        <p class="label ft-index-head">On this page</p>
        <ul>
          {spotlight.map((item, i) => (
            <li>
              <a href={`#${item.id}`}>
                <span class="ft-index-num">{num(i)}</span>
                <span class="ft-index-name">{item.name}</span>
                <span class="ft-state ft-state--dev"><i aria-hidden="true"></i>In development &middot; December</span>
              </a>
            </li>
          ))}
          <li>
            <a href="#companion">
              <span class="ft-index-num">{num(spotlight.length)}</span>
              <span class="ft-index-name">Companion app</span>
              <span class="ft-state"><i aria-hidden="true"></i>Exploring</span>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </section>

  <!-- THE STANCE -->
  <section class="ft-stance" aria-labelledby="stance-title">
    <div class="wrap ft-stance-grid" data-reveal>
      <h2 id="stance-title" class="display ft-h2"><span>Flow suggests.</span> You decide<i class="ft-stop" aria-hidden="true"></i></h2>
      <div class="ft-stance-body">
        <p>Most AI editing tools decide what’s important in your content for you. Flow works the other way.</p>
        <p>It reads the moments you marked and the events Flowmaster found, suggests what to make, and waits for your yes. You mark the moments. We handle the tedious cuts.</p>
      </div>
    </div>
  </section>

  <!-- IN DEVELOPMENT: Events and Flow AI -->
  {spotlight.map((item, i) => (
    <section class="ft-feature" id={item.id} aria-labelledby={`${item.id}-title`}>
      <div class={`wrap ft-feature-grid ${i % 2 ? 'ft-feature-grid--flip' : ''}`}>
        <div class="ft-feature-copy" data-reveal>
          <p class="ft-tag">
            <span>{num(i)}</span>
            <span class="ft-state ft-state--dev"><i aria-hidden="true"></i>In development</span>
            <span class="ft-tag-when">December release</span>
          </p>
          <h2 id={`${item.id}-title`} class="display ft-h2 ft-feature-title">{item.name}<i class="ft-stop ft-stop--y" aria-hidden="true"></i></h2>
          <p class="ft-feature-lead">{item.lead}</p>
          <ul class="ft-facts">
            {item.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
        <figure class="ft-shot" data-reveal style="--reveal-delay:.12s">
          <img src={item.image} alt={item.alt} loading="lazy" width="1080" height="800" />
          <figcaption class="label"><span>{item.caption}</span><span>In development &middot; December</span></figcaption>
        </figure>
      </div>
    </section>
  ))}

  <!-- EXPLORING: companion app -->
  <section class="ft-app" id="companion" aria-labelledby="companion-title">
    <div class="wrap">
      <div class="ft-app-grid">
        <div class="ft-app-head" data-reveal>
          <p class="ft-tag">
            <span>{num(spotlight.length)}</span>
            <span class="ft-state"><i aria-hidden="true"></i>Exploring</span>
            <span class="ft-tag-when">Loosely planned</span>
          </p>
          <h2 id="companion-title" class="display ft-h2">Your session, <span>in your pocket</span></h2>
          <p class="ft-feature-lead">A companion app is loosely planned: mark moments and keep an eye on your session from your phone.</p>
        </div>
        <div class="ft-phones" data-reveal style="--reveal-delay:.12s">
          <img class="ft-phone ft-phone--portrait" src={portraitMock.src} width={portraitMock.width} height={portraitMock.height} loading="lazy" alt="Concept mockup of the companion app held upright: a recording timeline, the game feed, a live timer and a large Mark button" />
          <img class="ft-phone ft-phone--landscape" src={landscapeMock.src} width={landscapeMock.width} height={landscapeMock.height} loading="lazy" alt="Concept mockup of the companion app held sideways: the game feed beside a list of recent markers, a Mark button and a timeline along the bottom" />
        </div>
      </div>

      <ul class="ft-benefits" data-reveal>
        {appBenefits.map((benefit, i) => (
          <li>
            <span class="ft-benefit-num" aria-hidden="true">{num(i)}</span>
            <h3>{benefit.title}</h3>
            <p>{benefit.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="ft-why" aria-labelledby="why-title">
    <div class="wrap ft-why-grid">
      <div class="ft-why-head" data-reveal>
        <p class="label">Compared</p>
        <h2 id="why-title" class="display ft-h2">Why Flowmaster?</h2>
        <p>See how Flowmaster compares to other tools in the space.</p>
      </div>
      <ul class="ft-versus" data-reveal style="--reveal-delay:.12s">
        {comparisons.map((item) => (
          <li>
            <span class="ft-versus-tag">{item.versus}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="ft-closing" aria-labelledby="closing-title">
    <div class="wrap ft-closing-grid" data-reveal>
      <h2 id="closing-title" class="display ft-closing-title"><span>Want to shape</span> the future?</h2>
      <div class="ft-closing-side">
        <p>Join our Discord to vote on features and get early access to new releases.</p>
        <div class="ft-actions">
          <a class="btn-primary" href="https://discord.gg/S8uJpcK3qJ">Join Discord</a>
          <a class="arrow-link" href="/download">Free trial details</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Shared pieces ---------- */
  .ft-stop {
    display: inline-block;
    width: 0.2em;
    height: 0.195em;
    margin-left: 0.05em;
    border-radius: 0.02em;
    background: currentColor;
  }
  .ft-stop--y { background: var(--yellow); }
  .ft-h2 { font-size: clamp(2.5rem, 5vw, 4.25rem); }
  .ft-h2 > span { color: var(--ink-3); }

  /* Status: a marker square and a mono word. Yellow is "being built". */
  .ft-state {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .ft-state i { width: 0.6rem; height: 0.58rem; border-radius: 1.5px; background: var(--ink-3); flex: none; }
  .ft-state--dev { color: var(--yellow); }
  .ft-state--dev i { background: var(--yellow); }

  .ft-tag {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .ft-tag-when { padding-left: 0.75rem; border-left: 1px solid var(--rule-strong); }

  /* ---------- Top ---------- */
  .ft-top { padding: calc(var(--nav-h) + clamp(2.5rem, 6vw, 5rem)) 0 clamp(3.5rem, 7vw, 6rem); }
  .ft-top-grid { display: grid; gap: 3rem; }
  .ft-top-grid > * { min-width: 0; }
  .ft-title { margin-top: 1.1rem; font-size: clamp(2.9rem, 7.4vw, 6.25rem); line-height: 0.86; font-stretch: 62%; }
  .ft-title > span { display: block; color: var(--ink-3); }
  .ft-lede { margin-top: 1.5rem; max-width: 31rem; font-size: clamp(1.1rem, 1.5vw, 1.25rem); line-height: 1.5; color: var(--ink); }

  .ft-index-head { margin-bottom: 0.85rem; }
  .ft-index ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule-strong); }
  .ft-index a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem 1rem;
    min-height: 3.75rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.18s ease;
  }
  .ft-index a:hover { border-bottom-color: var(--yellow); }
  .ft-index-num { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; color: var(--ink-3); }
  .ft-index-name { font-size: 1.15rem; font-weight: 650; }

  @media (min-width: 960px) {
    .ft-top-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(3rem, 6vw, 6rem); align-items: end; }
  }
  @media (max-width: 420px) {
    .ft-index a { grid-template-columns: 2.25rem minmax(0, 1fr); }
    .ft-index a .ft-state { grid-column: 2; }
  }

  /* ---------- The stance ---------- */
  .ft-stance { padding: clamp(4rem, 8vw, 6.5rem) 0; border-top: 1px solid var(--rule); background: #0c0c0c; }
  .ft-stance-grid { display: grid; gap: 2rem; }
  .ft-stance .ft-h2 > span { display: block; }
  .ft-stance-body { display: grid; gap: 1.1rem; max-width: 36rem; }
  .ft-stance-body p { font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.5; color: var(--ink); }
  .ft-stance-body p + p { color: var(--ink-2); }
  @media (min-width: 960px) {
    .ft-stance-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: clamp(3rem, 7vw, 7rem); align-items: end; }
  }

  /* ---------- Events and Flow AI ---------- */
  .ft-feature { padding: clamp(4rem, 8vw, 6.5rem) 0; border-top: 1px solid var(--rule); scroll-margin-top: var(--nav-h); }
  .ft-feature-grid { display: grid; gap: 2.5rem; }
  .ft-feature-grid > * { min-width: 0; }
  .ft-feature-title { margin-top: 1.25rem; }
  .ft-feature-lead { margin-top: 1.25rem; max-width: 31rem; font-size: clamp(1.1rem, 1.5vw, 1.25rem); line-height: 1.5; color: var(--ink); }
  .ft-facts { list-style: none; margin: 1.75rem 0 0; padding: 0; max-width: 34rem; border-top: 1px solid var(--rule-strong); }
  .ft-facts li {
    position: relative;
    padding: 0.85rem 0 0.85rem 1.5rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.99rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .ft-facts li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 1.34rem;
    width: 0.5rem;
    height: 0.48rem;
    border-radius: 1.5px;
    background: var(--ink-3);
  }

  .ft-shot { margin: 0; }
  .ft-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    background: #07080b;
  }
  .ft-shot figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.3rem 1.25rem;
    margin-top: 0.9rem;
    font-size: 0.68rem;
  }
  @media (min-width: 1000px) {
    .ft-feature-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(3rem, 6vw, 6rem); align-items: start; }
    .ft-feature-grid--flip { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
    .ft-feature-grid--flip > .ft-feature-copy { order: 2; }
    .ft-shot { position: sticky; top: calc(var(--nav-h) + 2rem); }
  }
  @media (min-width: 640px) and (max-width: 999px) {
    .ft-shot { max-width: 42rem; }
  }

  /* ---------- Companion app ---------- */
  .ft-app { padding: clamp(4rem, 8vw, 6.5rem) 0; border-top: 1px solid var(--rule); background: #0c0c0c; scroll-margin-top: var(--nav-h); }
  .ft-app-grid { display: grid; gap: 3rem; }
  .ft-app-grid > * { min-width: 0; }
  .ft-app-head .ft-h2 { margin-top: 1.25rem; }
  .ft-app-head .ft-h2 > span { display: block; }
  .ft-phones { display: flex; align-items: center; justify-content: center; gap: 5%; max-width: 40rem; }
  .ft-phone { display: block; height: auto; filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.55)); }
  .ft-phone--portrait { width: 27%; }
  .ft-phone--landscape { width: 68%; }

  .ft-benefits {
    list-style: none;
    display: grid;
    gap: 0 2.5rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .ft-benefits li { padding: 1.4rem 0 1.5rem; border-bottom: 1px solid var(--rule); }
  .ft-benefit-num { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; color: var(--ink-3); }
  .ft-benefits h3 { margin-top: 0.7rem; font-size: 1.15rem; line-height: 1.3; }
  .ft-benefits p { margin-top: 0.5rem; font-size: 0.97rem; line-height: 1.55; }
  @media (min-width: 640px) {
    .ft-benefits { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 960px) {
    .ft-app-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(3rem, 6vw, 6rem); align-items: center; }
    .ft-phones { margin-left: auto; }
  }
  @media (min-width: 1100px) {
    .ft-benefits { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .ft-benefits li { border-bottom: 0; padding-bottom: 0; }
  }

  /* ---------- Comparison ---------- */
  .ft-why { padding: clamp(4rem, 8vw, 6.5rem) 0; border-top: 1px solid var(--rule); }
  .ft-why-grid { display: grid; gap: 3rem; }
  .ft-why-head .ft-h2 { margin-top: 1rem; }
  .ft-why-head > p:not(.label) { margin-top: 1.5rem; max-width: 26rem; }
  .ft-versus { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule-strong); }
  .ft-versus li {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.4rem 0 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .ft-versus-tag {
    padding-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .ft-versus h3 { font-size: 1.25rem; line-height: 1.3; }
  .ft-versus p { margin-top: 0.45rem; font-size: 1rem; line-height: 1.55; }
  @media (min-width: 960px) {
    .ft-why-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: clamp(3rem, 7vw, 7rem); }
    .ft-why-head { position: sticky; top: calc(var(--nav-h) + 2rem); align-self: start; }
  }
  @media (max-width: 520px) {
    .ft-versus li { grid-template-columns: 1fr; gap: 0.4rem; }
    .ft-versus-tag { padding-top: 0; }
  }

  /* ---------- Closing ---------- */
  .ft-closing { padding: clamp(4rem, 8vw, 6.5rem) 0; border-top: 1px solid var(--rule); }
  .ft-closing-grid { display: grid; gap: 2rem; }
  .ft-closing-title { font-size: clamp(2.7rem, 6vw, 5.4rem); line-height: 0.88; font-stretch: 62%; }
  .ft-closing-title span { display: block; color: var(--ink-3); }
  .ft-closing-side p { max-width: 28rem; font-size: 1.06rem; color: var(--ink); }
  .ft-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.75rem; margin-top: 1.6rem; }
  .ft-actions .btn-primary { min-height: 3.4rem; padding: 0.9rem 1.6rem; font-size: 1.08rem; }
  @media (min-width: 1000px) {
    .ft-closing-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 3rem 5rem; align-items: end; }
  }
</style>
