---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Paid access unavailable" description="Flowmaster is preparing a free trial. Purchases and paid upgrades are unavailable.">
  <section class="section-padding"><div class="container-main max-w-2xl mx-auto text-center">
    <h1 class="mb-6">Paid access is unavailable.</h1>
    <p class="text-lg mb-6">Flowmaster is preparing a free 30-action trial with a required free account. We are not accepting purchases or paid upgrades.</p>
    <p class="mb-8">For help with an earlier purchase, use the community contact linked below.</p>
    <a class="btn-primary" href="/download">Free trial details</a>
  </div></section>
</BaseLayout>
