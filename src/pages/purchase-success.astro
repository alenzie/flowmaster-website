---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/notice.css';
---
<BaseLayout title="Paid access unavailable" description="Flowmaster is preparing a free trial. Purchases and paid upgrades are unavailable.">
  <section class="nf">
    <div class="wrap nf-grid">
      <div class="nf-copy">
        <p class="label">Purchases</p>
        <h1 class="display nf-title nf-title--long">Paid access <span>is unavailable<i class="nf-stop" aria-hidden="true"></i></span></h1>
        <p class="nf-lede">Flowmaster is preparing a free 90-action trial with a required free account. We are not accepting purchases or paid upgrades.</p>
        <p class="nf-more">For help with an earlier purchase, use the community contact linked below.</p>
        <div class="nf-actions">
          <a class="btn-primary" href="/download">Free trial details</a>
        </div>
      </div>
      <div class="nf-side nf-side--after">
        <div class="nf-thirty" role="img" aria-label="Ninety squares, one for each action in the free trial.">
          {Array.from({ length: 90 }).map(() => <i></i>)}
        </div>
        <p class="label nf-thirty-cap">Free 90-action trial &middot; free account required</p>
      </div>
    </div>
  </section>
</BaseLayout>
