---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/notice.css';
---
<BaseLayout title="Paid access unavailable" description="Flowmaster is free with a free account. Purchases and paid upgrades are unavailable.">
  <section class="nf">
    <div class="wrap nf-grid">
      <div class="nf-copy">
        <p class="label">Purchases</p>
        <h1 class="display nf-title nf-title--long">Paid access <span>is unavailable<i class="nf-stop" aria-hidden="true"></i></span></h1>
        <p class="nf-lede">Flowmaster is free with a free account. We are not accepting purchases or paid upgrades.</p>
        <p class="nf-more">For help with an earlier purchase, use the community contact linked below.</p>
        <div class="nf-actions">
          <a class="btn-primary" href="/download">Download details</a>
        </div>
      </div>
      <div class="nf-side nf-side--after">
      </div>
    </div>
  </section>
</BaseLayout>
