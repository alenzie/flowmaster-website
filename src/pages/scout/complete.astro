<BaseLayout title="Scout registration paused" description="New scout accounts are currently unavailable. Check Flowmaster’s free trial release status.">
  <section class="section-padding"><div class="container-main max-w-2xl mx-auto text-center">
    <h1 class="mb-6">Scout registration is paused.</h1>
