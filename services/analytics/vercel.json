{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["pdx1"],
  "functions": { "api/*.js": { "maxDuration": 15 } },
  "crons": [{ "path": "/api/retention", "schedule": "17 8 * * *" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://wwuafjftlttmkvhzgtxh.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
  ] }]
}
